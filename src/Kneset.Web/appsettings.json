{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sync": {
    "Enabled": true,
    // 0 — синхронизировать один раз при старте (для хостинга, где инстанс засыпает).
    "IntervalHours": 6
  },
  "Initiatives": {
    "SignatureThreshold": 10000
  }
}
