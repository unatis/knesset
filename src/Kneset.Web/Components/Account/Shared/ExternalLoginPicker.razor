@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Kneset.Core.Entities;
@using Kneset.Infrastructure.Data
@inject SignInManager<AppUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<SharedResource> L

@* Провайдеров нет — не показываем ничего. В скаффолде здесь стоял абзац
   со ссылкой на документацию Microsoft о том, как их настроить: сообщение
   разработчику, адресованное посетителю. Ни одного внешнего провайдера
   в Program.cs не зарегистрировано, поэтому видели его все.

   Есть ли провайдеры, знает только этот компонент, поэтому страницы входа
   и регистрации спрашивают его через HasProviders — иначе там остался бы
   висеть заголовок над пустотой. *@
@if (externalLogins.Length > 0)
{
    <form class="form-horizontal" action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <p>
                @foreach (var provider in externalLogins)
                {
                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="@string.Format(L["Mng_LoginUsing"], provider.DisplayName)">@provider.DisplayName</button>
                }
            </p>
        </div>
    </form>
}

@code {
    /// <summary>
    /// Есть ли хоть один внешний провайдер. Спрашивают страницы входа
    /// и регистрации, чтобы не рисовать заголовок над пустым блоком.
    /// Знание о провайдерах остаётся в одном месте — здесь.
    /// </summary>
    public static async Task<bool> HasProvidersAsync(SignInManager<AppUser> signInManager) =>
        (await signInManager.GetExternalAuthenticationSchemesAsync()).Any();

    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
