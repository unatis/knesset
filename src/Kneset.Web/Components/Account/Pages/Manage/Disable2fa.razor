@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using Kneset.Core.Entities;
@using Kneset.Infrastructure.Data
@inject UserManager<AppUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Mng_Disable2faTitle"]</PageTitle>

<StatusMessage />
<h3>@L["Mng_Disable2faTitle"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@L["Mng_Disable2faNote"]</strong>
    </p>
    <p>@L["Mng_ResetKeysNote"]</p>
    <p><a href="Account/Manage/ResetAuthenticator">@L["Mng_ResetAuthApp"]</a></p>
</div>

<div>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="btn btn-danger" type="submit">@L["Mng_Disable2fa"]</button>
    </form>
</div>

@code {
    private AppUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        // Отключать нечего — просто возвращаем на страницу двухфакторной.
        // В скаффолде здесь летело исключение, то есть страница 500 всякому,
        // кто зашёл по прямой ссылке или успел выключить 2FA в другой вкладке.
        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            RedirectManager.RedirectTo("Account/Manage/TwoFactorAuthentication");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred disabling 2FA.");
        }

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            L["Mng_Msg2faDisabled"],
            HttpContext);
    }
}
