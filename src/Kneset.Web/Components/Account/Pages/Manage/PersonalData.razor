@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Kneset.Core.Entities;
@using Kneset.Infrastructure.Data
@inject UserManager<AppUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Mng_PersonalData"]</PageTitle>

<StatusMessage />
<h3>@L["Mng_PersonalData"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@L["Mng_PersonalDataText"]</p>
        <p>
            <strong>@L["Mng_DeleteWarning"]</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@L["Mng_Download"]</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@L["Mng_Delete"]</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
