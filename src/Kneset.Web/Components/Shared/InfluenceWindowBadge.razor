@inject IStringLocalizer<SharedResource> L

@* Бейдж «окно влияния»: переводит этап законодательного процесса на язык действия —
   можно ли ещё повлиять на закон и как. Маппинг по ключевым словам ивритских статусов. *@
@if (Window is not null)
{
    <span class="badge @Window.Value.Css" title="@(ShowHint ? null : L[Window.Value.HintKey])">@L[Window.Value.LabelKey]</span>
    @if (ShowHint)
    {
        <div class="text-muted small mt-1">@L[Window.Value.HintKey]</div>
    }
}

@code {
    [Parameter] public string? StatusDesc { get; set; }

    /// <summary>true — показывать пояснение текстом (карточка); false — только плашка (список).</summary>
    [Parameter] public bool ShowHint { get; set; }

    private (string Css, string LabelKey, string HintKey)? Window => Classify(StatusDesc);

    /// <summary>
    /// Группы влияния по этапам: заморожен → поздно → комиссия (окно открыто) → зал (ограничено).
    /// Порядок проверки важен. Возвращает ключи ресурсов (локализуются при рендере).
    /// </summary>
    public static (string Css, string LabelKey, string HintKey)? Classify(string? status)
    {
        if (string.IsNullOrEmpty(status)) return null;

        // Процесс остановлен: снят, заморожен, слит, отклонён, преобразован.
        if (status.Contains("נעצרה") || status.Contains("מוזגה") || status.Contains("הוסרה")
            || status.Contains("הוסר") || status.Contains("נדחתה") || status.Contains("נדחה")
            || status.Contains("הוסבה"))
            return ("bg-secondary", "Inf_Frozen", "Inf_Frozen_Hint");

        // Принят / утверждён — поздно.
        if (status.Contains("התקבלה") || status.Contains("התקבל") || status.Contains("אושרה")
            || status.Contains("אושר"))
            return ("bg-danger", "Inf_Late", "Inf_Late_Hint");

        // Работа в комиссии — главное окно влияния.
        if (status.Contains("ועדה") || status.Contains("הכנה"))
            return ("bg-success", "Inf_Open", "Inf_Open_Hint");

        // Ждёт обсуждения в зале — влияние только через депутатов.
        if (status.Contains("מליאה") || status.Contains("הונחה") || status.Contains("שולחן"))
            return ("bg-warning text-dark", "Inf_Limited", "Inf_Limited_Hint");

        return null;
    }
}
