@inject IStringLocalizer<SharedResource> L

@* Бейдж «окно влияния»: переводит этап законодательного процесса на язык действия —
   можно ли ещё повлиять на закон и как. Маппинг по ключевым словам ивритских статусов.

   Визуальный слой: вместо bg-secondary / bg-success / bg-warning — классы kt-win-*.
   Цвет несёт срочность, точка перед текстом (::before в app.css) дублирует его
   для дальтоников и ч/б печати. Логика Classify не изменилась. *@
@if (Window is not null)
{
    <span class="kt-win @Window.Value.Css" title="@(ShowHint ? null : L[Window.Value.HintKey])">@L[Window.Value.LabelKey]</span>
    @if (ShowHint)
    {
        <div class="kt-win-hint">@L[Window.Value.HintKey]</div>
    }
}

@code {
    [Parameter] public string? StatusDesc { get; set; }

    /// <summary>true — показывать пояснение текстом (карточка); false — только плашка (список).</summary>
    [Parameter] public bool ShowHint { get; set; }

    /// <summary>Созыв законопроекта и текущий созыв — вместе решают, не истёк ли он.</summary>
    [Parameter] public int? KnessetNum { get; set; }

    [Parameter] public int? CurrentKnesset { get; set; }

    private (string Css, string LabelKey, string HintKey)? Window
        => Classify(StatusDesc, KnessetNum, CurrentKnesset);

    /// <summary>
    /// Группы влияния по этапам: заморожен → поздно → комиссия (окно открыто) → зал (ограничено).
    /// Порядок проверки важен. Возвращает ключи ресурсов (локализуются при рендере).
    ///
    /// Созыв, если он известен, проверяется после текста статуса — см. Expired ниже.
    /// </summary>
    public static (string Css, string LabelKey, string HintKey)? Classify(
        string? status, int? knessetNum = null, int? currentKnesset = null)
    {
        var byStatus = ClassifyByStatus(status);
        return Expired(status, knessetNum, currentKnesset) ? ExpiredWindow(byStatus) : byStatus;
    }

    /// <summary>
    /// Законопроект прекратился вместе со своим созывом.
    ///
    /// С концом созыва незавершённые законодательные процедуры прекращаются:
    /// в новом Кнессете законопроект вносят заново. Статус при этом не меняется —
    /// Кнессет не помечает такие записи, они просто перестают двигаться. Поэтому
    /// по одному тексту статуса законопроект 24-го созыва, замерший в ноябре 2022
    /// на подготовке ко второму чтению, до сих пор обещал открытое окно влияния.
    ///
    /// Исключение — статусы о применении преемственности (רציפות): там как раз
    /// решается возвращение законопроекта к жизни, и окно там настоящее.
    /// </summary>
    private static bool Expired(string? status, int? knessetNum, int? currentKnesset) =>
        knessetNum is { } num && currentKnesset is { } current
        && num < current
        && status?.Contains("רציפות") != true;

    /// <summary>
    /// Подменяет группу на «созыв завершён» — но только там, где статус обещал
    /// продолжение. Принятый закон остаётся принятым, а снятый — снятым:
    /// они завершились сами, а не вместе с созывом.
    /// </summary>
    private static (string, string, string)? ExpiredWindow((string Css, string, string)? byStatus) =>
        byStatus?.Css is "kt-win-open" or "kt-win-limited" or "kt-win-pending"
            ? ("kt-win-expired", "Inf_Expired", "Inf_Expired_Hint")
            : byStatus;

    private static (string Css, string LabelKey, string HintKey)? ClassifyByStatus(string? status)
    {
        if (string.IsNullOrEmpty(status)) return null;

        // Процесс остановлен: снят, заморожен, слит, отклонён, преобразован.
        if (status.Contains("נעצרה") || status.Contains("מוזגה") || status.Contains("הוסרה")
            || status.Contains("הוסר") || status.Contains("נדחתה") || status.Contains("נדחה")
            || status.Contains("הוסבה"))
            return ("kt-win-frozen", "Inf_Frozen", "Inf_Frozen_Hint");

        // Принят / утверждён — поздно.
        if (status.Contains("התקבלה") || status.Contains("התקבל") || status.Contains("אושרה")
            || status.Contains("אושר"))
            return ("kt-win-late", "Inf_Late", "Inf_Late_Hint");

        // Процедура до содержания: решается, какая комиссия возьмёт закон.
        // Проверяется раньше общей «комиссии» — иначе слово ועדה в строке
        // отправило бы стадию в открытое окно, а окна там нет: содержание
        // ещё не обсуждают, и прийти со своей позицией пока некуда.
        if (status.Contains("קביעת הוועדה"))
            return ("kt-win-pending", "Inf_Pending", "Inf_Pending_Hint");

        // Работа в комиссии — главное окно влияния.
        if (status.Contains("ועדה") || status.Contains("הכנה"))
            return ("kt-win-open", "Inf_Open", "Inf_Open_Hint");

        // Ждёт обсуждения в зале — влияние только через депутатов.
        if (status.Contains("מליאה") || status.Contains("הונחה") || status.Contains("שולחן"))
            return ("kt-win-limited", "Inf_Limited", "Inf_Limited_Hint");

        return null;
    }

    /// <summary>Открыто ли окно — нужно карточке закона, чтобы выбрать оформление полосы.</summary>
    public static bool IsOpen(string? status, int? knessetNum = null, int? currentKnesset = null)
        => Classify(status, knessetNum, currentKnesset)?.Css is "kt-win-open" or "kt-win-limited";
}
