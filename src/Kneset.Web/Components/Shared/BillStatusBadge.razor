@* Бейдж статуса законопроекта. Статусы приходят на иврите из KNS_Status.

   Визуальный слой: плашка стала нейтральной. Раньше она конкурировала с бейджем
   окна влияния — два цветных бейджа рядом читались как два разных сигнала.
   Теперь срочность несёт только окно влияния, а статус — это факт из источника. *@
@if (!string.IsNullOrEmpty(StatusDesc))
{
    <span class="kt-status @CssClass" dir="rtl" lang="he">@StatusDesc</span>
}

@code {
    [Parameter] public string? StatusDesc { get; set; }

    // Три группы: процесс завершён, процесс остановлен, работа идёт.
    private string CssClass =>
        StatusDesc is null ? "kt-status-done"
        : StatusDesc.Contains("אושר") || StatusDesc.Contains("התקבל") ? "kt-status-done"
        : StatusDesc.Contains("הוסר") || StatusDesc.Contains("נדחה") || StatusDesc.Contains("נעצר") ? "kt-status-stopped"
        : StatusDesc.Contains("ועדה") || StatusDesc.Contains("קריאה") ? "kt-status-active"
        : "kt-status-done";
}
