@* Бейдж статуса законопроекта. Статусы приходят на иврите из KNS_Status. *@
@if (!string.IsNullOrEmpty(StatusDesc))
{
    <span class="badge @CssClass" dir="rtl" lang="he">@StatusDesc</span>
}

@code {
    [Parameter] public string? StatusDesc { get; set; }

    // Грубая раскраска по ключевым словам ивритских статусов:
    // аранжевый — в работе/комиссии, зелёный — принят/утверждён, красный — снят/отклонён.
    private string CssClass =>
        StatusDesc is null ? "bg-secondary"
        : StatusDesc.Contains("אושר") || StatusDesc.Contains("התקבל") ? "bg-success"
        : StatusDesc.Contains("הוסר") || StatusDesc.Contains("נדחה") || StatusDesc.Contains("נעצר") ? "bg-danger"
        : StatusDesc.Contains("ועדה") || StatusDesc.Contains("קריאה") ? "bg-warning text-dark"
        : "bg-secondary";
}
