@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<SharedResource> L
@inject IDbContextFactory<AppDbContext> DbFactory

@* Полная история AI-анализов закона: все версии на всех языках, с пометками
   «актуальный/устарел». Устаревшие версии остаются доступными навсегда —
   можно сравнить, как менялся анализ вместе с редакциями закона. *@
@if (_items is { Count: > 0 })
{
    <div class="card mt-4">
        <div class="card-header">@L["Hist_Header"] (@_items.Count)</div>
        <ul class="list-group list-group-flush">
            @foreach (var item in _items)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span>
                            @foreach (var lang in item.Languages)
                            {
                                <span class="badge bg-light text-dark border me-1">@lang.ToUpperInvariant()</span>
                            }
                            <strong>@item.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
                            <small class="text-muted"> · @item.ModelVersion</small>
                            @if (item.IsStale)
                            {
                                <span class="badge bg-secondary ms-1">@L["Hist_Stale"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success ms-1">@L["Hist_Current"]</span>
                            }
                        </span>
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => Toggle(item.Id)">
                            @(_expandedId == item.Id ? L["Hist_Hide"] : L["Hist_Show"])
                        </button>
                    </div>
                    @if (_expandedId == item.Id)
                    {
                        <div class="mt-3 border-top pt-3">
                            <AnalysisView Analysis="item.Analysis" />
                        </div>
                    }
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public int BillId { get; set; }

    private List<HistoryItem>? _items;
    private int? _expandedId;

    private record HistoryItem(
        int Id, List<string> Languages, string ModelVersion,
        DateTime GeneratedAt, bool IsStale, BillAnalysisResult? Analysis);

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entities = await db.BillAnalyses.AsNoTracking()
            .Where(a => a.BillId == BillId)
            .OrderByDescending(a => a.GeneratedAt)
            .ToListAsync();

        // Одна запись на генерацию, а не на строку в базе. Мастер-разбор
        // и его переводы — это один и тот же разбор на разных языках, и они
        // выглядели в истории как два отдельных «анализа»: пользователь видел
        // «история (2)» и решал, что закон разбирали дважды.
        //
        // Группируем по BillLastUpdatedAt: мастер и все его переводы берут
        // это поле из одного снимка законопроекта, поэтому оно и есть признак
        // генерации. IsStale в ключе потому, что при повторной генерации
        // без правки законопроекта снимок тот же, а генерация уже другая.
        _items = entities
            .GroupBy(e => (e.BillLastUpdatedAt, e.IsStale))
            .Select(g =>
            {
                // Показываем содержимое на языке интерфейса, иначе мастер,
                // иначе что есть: человеку нужен текст, который он прочтёт.
                var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                var shown = g.FirstOrDefault(e => e.LanguageCode == lang)
                            ?? g.FirstOrDefault(e => e.LanguageCode == "en")
                            ?? g.First();

                BillAnalysisResult? parsed = null;
                try { parsed = JsonSerializer.Deserialize<BillAnalysisResult>(shown.AnalysisJson); }
                catch (JsonException) { /* повреждённая запись — показываем без содержимого */ }

                return new HistoryItem(
                    shown.Id,
                    // Языки генерации — все, что есть: так видно, на какие
                    // из них разбор уже переведён, а на какие ещё нет.
                    g.Select(e => e.LanguageCode).Distinct().OrderBy(x => x).ToList(),
                    // Модель мастера: переводы делает другая и более дешёвая,
                    // и в истории важна та, что делала сам разбор.
                    (g.FirstOrDefault(e => e.LanguageCode == "en") ?? g.First()).ModelVersion,
                    g.Max(e => e.GeneratedAt),
                    shown.IsStale,
                    parsed);
            })
            .OrderByDescending(i => i.GeneratedAt)
            .ToList();
    }

    private void Toggle(int id) => _expandedId = _expandedId == id ? null : id;
}
