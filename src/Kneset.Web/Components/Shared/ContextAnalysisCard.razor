@using System.Text.Json
@inject IStringLocalizer<SharedResource> L
@inject IDbContextFactory<AppDbContext> DbFactory

@* Секция показывается, только если контекстный анализ существует. *@
@if (_context is not null)
{
    <div class="card mt-4 border-warning-subtle">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@L["Ctx_Header"]</span>
            <small class="text-muted">@_generatedAt?.ToLocalTime().ToString("dd.MM.yyyy") · @_modelVersion</small>
        </div>
        <div class="card-body">
            <div class="alert alert-warning py-2">
                @L["Ctx_Warning"]
            </div>

            @if (_context.ProviderNote is not null)
            {
                <div class="alert alert-light border py-2"><small>@_context.ProviderNote</small></div>
            }

            <div class="row">
                @if (_context.Beneficiaries.Count > 0)
                {
                    <div class="col-md-6">
                        <h6>@L["Ctx_WhoBenefits"]</h6>
                        <ul>
                            @foreach (var item in _context.Beneficiaries)
                            {
                                <li><strong>@item.Group:</strong> @item.Note</li>
                            }
                        </ul>
                    </div>
                }
                @if (_context.Concerned.Count > 0)
                {
                    <div class="col-md-6">
                        <h6>@L["Ctx_WhoConcerned"]</h6>
                        <ul>
                            @foreach (var item in _context.Concerned)
                            {
                                <li><strong>@item.Group:</strong> @item.Note</li>
                            }
                        </ul>
                    </div>
                }
            </div>

            @if (_context.DeFactoGoals.Count > 0)
            {
                <h6>@L["Ctx_DeFacto"] <span class="badge bg-warning text-dark">@L["Ctx_Interp"]</span></h6>
                <ul>
                    @foreach (var goal in _context.DeFactoGoals)
                    {
                        <li>@goal</li>
                    }
                </ul>
            }

            @if (_context.HistoricalParallels.Count > 0)
            {
                <h6>@L["Ctx_Parallels"]</h6>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr><th style="width:35%">@L["Ctx_Case"]</th><th>@L["Ctx_Lesson"]</th></tr></thead>
                        <tbody>
                            @foreach (var parallel in _context.HistoricalParallels)
                            {
                                <tr><td>@parallel.Case</td><td>@parallel.Lesson</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (_context.Perspectives.Count > 0)
            {
                <h6>@L["Ctx_Perspectives"] <small class="text-muted">@L["Ctx_PerspNote"]</small></h6>
                @foreach (var perspective in _context.Perspectives)
                {
                    <div class="border rounded p-2 mb-2">
                        <strong>@perspective.Group</strong>
                        <ul class="mb-0">
                            @foreach (var position in perspective.Positions)
                            {
                                <li>@position</li>
                            }
                        </ul>
                    </div>
                }
            }

            @if (_context.PublicImpact.Count > 0)
            {
                <h6 class="mt-3">@L["Ctx_Impact"]</h6>
                <ul>
                    @foreach (var impact in _context.PublicImpact)
                    {
                        <li>@impact</li>
                    }
                </ul>
            }

            <hr />
            <small class="text-muted">
                @L["Ctx_Footer"]
            </small>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public int BillId { get; set; }

    private BillContextResult? _context;
    private DateTime? _generatedAt;
    private string? _modelVersion;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.BillContextAnalyses.AsNoTracking()
            .Where(c => c.BillId == BillId && !c.IsStale)
            .OrderByDescending(c => c.GeneratedAt)
            .FirstOrDefaultAsync();

        if (entity is null)
        {
            _context = null;
            return;
        }

        try
        {
            _context = JsonSerializer.Deserialize<BillContextResult>(entity.ContextJson);
            _generatedAt = entity.GeneratedAt;
            _modelVersion = entity.ModelVersion;
        }
        catch (JsonException)
        {
            _context = null;
        }
    }
}
