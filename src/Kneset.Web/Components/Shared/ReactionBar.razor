@inject IStringLocalizer<SharedResource> L

@* Трёхцветный бар реакций: за (оливковый) → не определился (тёплый нейтральный) →
   против (обожжённый красный). Цвета остаются в тёплой семье, чтобы «за» и «против»
   не читались как партийные цвета.

   Всегда показывает размер выборки — процент без числа участников вводит в заблуждение,
   но с версии визуального слоя размер уходит в третью строку: он не должен
   конкурировать с самим результатом. Emoji (🤔 🗳 ⚠) убраны. *@
@if (Total > 0)
{
    <div>
        <div class="kt-bar @(Compact ? "kt-bar-compact" : null)">
            <div class="kt-bar-for" style="width:@Percent(Support)%" title="@L["For"]: @Support"></div>
            <div class="kt-bar-undecided" style="width:@Percent(Undecided)%" title="@L["DontKnow"]: @Undecided"></div>
            <div class="kt-bar-against" style="width:@Percent(Oppose)%" title="@L["Against"]: @Oppose"></div>
        </div>

        @if (!Compact)
        {
            <div class="kt-bar-legend">
                <span>@Percent(Support)% @L["For"]</span>
                <span>@Percent(Undecided)% @L["DontKnow"]</span>
                <span>@Percent(Oppose)% @L["Against"]</span>
            </div>
            <small class="kt-bar-sample">
                @L["Votes"] @Total
                @if (Decided > 0)
                {
                    <span> · @L["AmongDecided"] @(Support * 100 / Decided)%</span>
                }
                @if (Total < 10)
                {
                    <span> · @L["SmallSample"]</span>
                }
            </small>
        }
        else
        {
            <span class="kt-num">@Total @L["Votes"]</span>
        }
    </div>
}
else if (!Compact)
{
    <small class="kt-bar-sample">@L["NoVotes"]</small>
}

@code {
    [Parameter] public int Support { get; set; }
    [Parameter] public int Oppose { get; set; }
    [Parameter] public int Undecided { get; set; }

    /// <summary>Компактный режим для списков: только полоска и число голосов.</summary>
    [Parameter] public bool Compact { get; set; }

    private int Total => Support + Oppose + Undecided;
    private int Decided => Support + Oppose;

    private int Percent(int part) => Total == 0 ? 0 : (int)Math.Round(part * 100.0 / Total);
}
