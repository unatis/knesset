@using Kneset.Core.Entities
@using Kneset.Web.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L

@* Правый столбец главной (макет 2a). Блоки идут по убыванию ценности:
   срочное, вход по темам, инициативы, ждущие подписей, и спорное за неделю.
   Первый — единственный, отвечающий на вопрос «что мне делать сегодня»,
   поэтому он акцентный. Инициативы стоят выше спорного: там действие человека
   меняет исход напрямую, а не выражает мнение.

   Запросы живут здесь, а не на странице: столбец самостоятелен и его можно
   поставить на другой экран. Снаружи приходит только список законов, попавших
   в подписки, — считать его дважды не нужно. *@

<aside class="kt-ctx">

    @* --- 1. Срочное. Заголовок зависит от того, чем мы располагаем:
           «Окно закрывается», когда заседание назначено и срок настоящий,
           и «Окно ещё открыто», когда есть только время в стадии. Обещать
           закрытие без даты заседания нельзя — данные о нём ничего не знают. --- *@
    <section class="kt-ctx-card kt-ctx-card-accent">
        <h3 class="kt-ctx-title">@(_hasDeadlines ? L["Ctx_ClosingWindow"] : L["Ctx_OpenWindow"])</h3>

        @if (_closing.Count == 0)
        {
            <p class="kt-ctx-empty">@L["Ctx_ClosingEmpty"]</p>
        }
        else
        {
            <ul class="kt-ctx-list">
                @foreach (var item in _closing)
                {
                    <li>
                        <a href="/bills/@item.Id" lang="@(item.IsHebrew ? "he" : null)">@item.Title</a>
                        <span class="kt-num">
                            @Note(item)
                            @if (!item.UntilSession && item.StatusDesc is not null)
                            {
                                <span> · </span><span dir="rtl" lang="he">@item.StatusDesc</span>
                            }
                        </span>
                    </li>
                }
            </ul>
            <a class="kt-ctx-more" href="bills">@L["Ctx_AllBills"]</a>
        }
    </section>

    @* --- 2. Темы --- *@
    <section class="kt-ctx-card kt-ctx-hide-mobile">
        <h3 class="kt-ctx-title">@L["Ctx_Themes"]</h3>

        @if (_themes.Count == 0)
        {
            <p class="kt-ctx-empty">@L["Ctx_ThemesEmpty"]</p>
        }
        else
        {
            <div class="kt-ctx-chips">
                @foreach (var theme in _themes)
                {
                    @* Тема ведёт в поиск по названию: у законов нет предметной
                       рубрикации, и слово — единственное, чем сейчас можно
                       отобрать «что там с арендой». *@
                    <a class="kt-chip" href="bills?q=@Uri.EscapeDataString(theme.Word)">
                        <span dir="auto">@theme.Word</span>
                        <span class="kt-chip-num">@theme.Bills</span>
                    </a>
                }
            </div>
            <a class="kt-ctx-more" href="bills">@L["Ctx_AllThemes"]</a>
        }
    </section>

    @* --- 3. Инициативам нужны подписи. Стоит выше спорного: это
           единственный блок, где действие человека что-то меняет
           напрямую, а не выражает мнение. --- *@
    @if (_initiatives.Count > 0)
    {
        <section class="kt-ctx-card kt-ctx-hide-mobile">
            <h3 class="kt-ctx-title">@L["Ctx_Initiatives"]</h3>

            <ul class="kt-ctx-list">
                @foreach (var item in _initiatives)
                {
                    <li>
                        <a href="/initiatives/@item.Id">@item.Title</a>
                        <span class="kt-num">
                            @string.Format(L["Ctx_SignaturesLeft"], item.Left)
                        </span>
                    </li>
                }
            </ul>
            <a class="kt-ctx-more" href="initiatives">@L["Ctx_AllInitiatives"]</a>
        </section>
    }

    @* --- 4. О чём спорят за неделю --- *@
    <section class="kt-ctx-card kt-ctx-hide-mobile">
        <h3 class="kt-ctx-title">@L["Ctx_WeekDebate"]</h3>

        @if (_debated.Count == 0)
        {
            <p class="kt-ctx-empty">@L["Ctx_DebateEmpty"]</p>
        }
        else
        {
            <ul class="kt-ctx-list kt-ctx-list-num">
                @foreach (var item in _debated)
                {
                    <li>
                        <a href="/bills/@item.Id" lang="@(item.IsHebrew ? "he" : null)">@item.Title</a>
                        <span class="kt-num">@item.Comments</span>
                    </li>
                }
            </ul>
            <p class="kt-ctx-note">@L["Ctx_DebateNote"]</p>
        }
    </section>

</aside>

@code {
    /// <summary>
    /// Законы из подписок пользователя. Пусто или null — показываем срочное
    /// по всей базе: пустой блок бесполезнее неточного.
    /// </summary>
    [Parameter] public IReadOnlyCollection<int>? RelevantBillIds { get; set; }

    /// <summary>
    /// Строка блока «Окно закрывается». Days — либо дней до назначенного
    /// заседания (UntilSession = true), либо дней в текущей стадии, если
    /// заседание не назначено. Разница принципиальная: первое — настоящий
    /// срок, второе — только оценка снизу, и подписи у них разные.
    /// </summary>
    private sealed record ClosingItem(
        int Id, string Title, bool IsHebrew, string? StatusDesc, int Days,
        bool UntilSession = false, BillSessionKind? Kind = null);
    private sealed record ThemeItem(string Word, int Bills);
    private sealed record DebatedItem(int Id, string Title, bool IsHebrew, int Comments);

    /// <summary>Left — сколько подписей не хватает до порога.</summary>
    private sealed record InitiativeItem(int Id, string Title, int Left);

    private const int BlockSize = 3;
    private const int ThemeCount = 5;
    private const int DebateWindowDays = 7;

    /// <summary>
    /// Показываем ли настоящие сроки. От этого зависит заголовок блока:
    /// «Окно закрывается» вправе стоять только когда заседание назначено,
    /// иначе блок обещал бы закрытие, о котором данные ничего не знают.
    /// </summary>
    private bool _hasDeadlines;

    private List<ClosingItem> _closing = [];
    private List<ThemeItem> _themes = [];
    private List<DebatedItem> _debated = [];
    private List<InitiativeItem> _initiatives = [];

    /// <summary>
    /// По какому набору подписок столбец уже посчитан. Нужен потому, что
    /// параметры переустанавливаются при любой перерисовке страницы — в том числе
    /// при переключении табов ленты, — а три запроса на каждое нажатие таба
    /// столбцу не нужны: от таба он не зависит.
    /// </summary>
    private string? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        var key = RelevantBillIds is null ? "" : string.Join(",", RelevantBillIds.Order());
        if (_loadedFor == key) return;
        _loadedFor = key;

        await using var db = await DbFactory.CreateDbContextAsync();

        await LoadClosingAsync(db);
        await LoadThemesAsync(db);
        await LoadInitiativesAsync(db);
        await LoadDebatedAsync(db);
    }

    /// <summary>
    /// Подпись под названием. Собирается в C#, а не в разметке: Razor убирает
    /// пробелы между соседними @-выражениями, и «до заседания» с числом
    /// склеивались в «до заседания3дня».
    /// </summary>
    private string Note(ClosingItem item)
    {
        var days = $"{item.Days} {Plural.Of(item.Days, L["Ctx_DayForms"])}";

        if (!item.UntilSession)
            return $"{days} {L["Ctx_InStage"]}";

        var kind = item.Kind == BillSessionKind.Plenum ? L["Ctx_Plenum"] : L["Ctx_Committee"];
        return $"{L["Ctx_UntilSession"]} {days} · {kind}";
    }

    private async Task LoadClosingAsync(AppDbContext db)
    {
        var ids = RelevantBillIds?.ToList();

        // Порядок попыток — от самого точного к самому приблизительному.
        // 1. Назначенное заседание: настоящий срок, Кнессет публикует повестку
        //    заранее. Только здесь блок вправе называться «Окно закрывается».
        _closing = await QueryUpcomingAsync(db, ids);
        _hasDeadlines = _closing.Count > 0;

        // 2. Среди подписок заседаний нет — ищем по всей базе.
        if (_closing.Count == 0 && ids is { Count: > 0 })
        {
            _closing = await QueryUpcomingAsync(db, null);
            _hasDeadlines = _closing.Count > 0;
        }

        // 3. Назначенных заседаний нет вовсе — откатываемся на «сколько
        //    закон уже в стадии». Это не срок, и заголовок блока меняется.
        if (_closing.Count == 0)
        {
            _closing = await QueryClosingAsync(db, ids);
            if (_closing.Count == 0 && ids is { Count: > 0 })
                _closing = await QueryClosingAsync(db, null);
        }
    }

    /// <summary>
    /// Законы, назначенные на будущее заседание, — ближайшие сверху.
    /// Это и есть настоящий срок «окно закрывается через N дней»: раньше
    /// в данных его не было, он появился вместе с BillSession.
    /// </summary>
    private async Task<List<ClosingItem>> QueryUpcomingAsync(AppDbContext db, List<int>? ids)
    {
        var now = DateTime.UtcNow;
        var query = db.BillSessions.AsNoTracking().Where(s => s.StartDate > now);

        if (ids is { Count: > 0 })
            query = query.Where(s => ids.Contains(s.BillId));

        // Берём запас: у одного закона может быть несколько будущих заседаний,
        // а нужно ближайшее — схлопываем в памяти.
        var rows = await query
            .OrderBy(s => s.StartDate)
            .Take(BlockSize * 10)
            .Select(s => new
            {
                s.BillId,
                s.StartDate,
                s.Kind,
                s.Bill.Name,
                s.Bill.NameRu,
                s.Bill.StatusDesc
            })
            .ToListAsync();

        return rows
            .GroupBy(r => r.BillId)
            .Select(g => g.First())
            .Take(BlockSize)
            .Select(r => new ClosingItem(
                r.BillId,
                r.NameRu ?? r.Name,
                r.NameRu == null,
                r.StatusDesc,
                Math.Max(0, (int)(r.StartDate - now).TotalDays),
                UntilSession: true,
                Kind: r.Kind))
            .ToList();
    }

    private async Task<List<ClosingItem>> QueryClosingAsync(AppDbContext db, List<int>? ids)
    {
        var query = db.Bills.AsNoTracking();

        if (ids is { Count: > 0 })
            query = query.Where(b => ids.Contains(b.Id));

        // Открытость окна считает InfluenceWindowBadge по ключевым словам ивритского
        // статуса, и это C#-логика — в SQL её не перевести. Но отбирать «самые
        // залежавшиеся» без предфильтра нельзя: наверху окажутся древние мёртвые
        // законы, и до открытых дело не дойдёт. Поэтому в SQL сужаем до статусов
        // со словами стадий, где окно вообще может быть открыто, — это надмножество
        // правила Classify, — а точное решение принимаем в памяти.
        var stageWords = new[] { "%ועדה%", "%הכנה%", "%מליאה%", "%הונחה%", "%שולחן%" };
        query = query.Where(b => b.StatusDesc != null && stageWords.Any(w =>
            EF.Functions.ILike(b.StatusDesc!, w)));

        // Срока до конца стадии в данных нет — есть только момент, с которого закон
        // в ней находится. У давно лежащих в комиссии StatusChangedAt пустой:
        // смену стадии мы ни разу не наблюдали. Тогда отсчитываем от первой встречи
        // с законом — он уже был в этой стадии, значит оценка снизу, а не выдумка.
        // Порядок — от самых свежих. Сортировка «кто дольше лежит» кажется
        // логичной для срочности, но поднимает наверх заброшенные законы:
        // в базе есть висящие в стадии по 1385 дней, и делать с ними сегодня
        // нечего. Свежий вход в открытую стадию — единственный сигнал
        // актуальности, который данные дают без сроков.
        var candidates = await query
            .OrderByDescending(b => b.StatusChangedAt ?? b.FirstSeenAt)
            .Take(BlockSize * 20)
            .Select(b => new
            {
                b.Id,
                b.Name,
                b.NameRu,
                b.StatusDesc,
                Since = b.StatusChangedAt ?? b.FirstSeenAt
            })
            .ToListAsync();

        return candidates
            .Where(b => InfluenceWindowBadge.IsOpen(b.StatusDesc))
            .Take(BlockSize)
            .Select(b => new ClosingItem(
                b.Id,
                b.NameRu ?? b.Name,
                b.NameRu == null,
                b.StatusDesc,
                Math.Max(0, (int)(DateTime.UtcNow - b.Since).TotalDays)))
            .ToList();
    }

    private async Task LoadThemesAsync(AppDbContext db)
    {
        // Предметных тем в модели нет, есть подписки на слова. Берём самые
        // популярные среди всех пользователей: это единственный имеющийся
        // сигнал о том, что людям интересно.
        var words = await db.NotificationSubscriptions.AsNoTracking()
            .Where(s => s.Kind == SubscriptionKind.Keyword && s.Keyword != null)
            .GroupBy(s => s.Keyword!)
            .Select(g => new { Word = g.Key, Subscribers = g.Count() })
            .OrderByDescending(x => x.Subscribers)
            .Take(ThemeCount)
            .ToListAsync();

        var themes = new List<ThemeItem>();
        foreach (var w in words)
        {
            var pattern = $"%{w.Word.Trim()}%";
            var count = await db.Bills.AsNoTracking()
                .CountAsync(b => EF.Functions.ILike(b.Name, pattern)
                              || (b.NameRu != null && EF.Functions.ILike(b.NameRu, pattern)));
            themes.Add(new ThemeItem(w.Word, count));
        }

        _themes = themes;
    }

    /// <summary>
    /// Инициативы, которым ближе всего до порога. Сортировка по остатку,
    /// а не по свежести: смысл блока — показать, где несколько подписей
    /// решают дело, а не перечислить последнее опубликованное.
    /// </summary>
    private async Task LoadInitiativesAsync(AppDbContext db)
    {
        var rows = await db.CitizenInitiatives.AsNoTracking()
            .Where(i => i.Status == InitiativeStatus.Published && i.PublishedAt != null)
            .Select(i => new
            {
                i.Id,
                i.Title,
                Left = i.SignatureThreshold - i.Signatures.Count
            })
            .Where(x => x.Left > 0)
            .OrderBy(x => x.Left)
            .Take(BlockSize)
            .ToListAsync();

        _initiatives = rows.Select(x => new InitiativeItem(x.Id, x.Title, x.Left)).ToList();
    }

    private async Task LoadDebatedAsync(AppDbContext db)
    {
        var since = DateTime.UtcNow.AddDays(-DebateWindowDays);

        // Сортировка только по количеству, без учёта тональности: любая попытка
        // учесть «за» и «против» сделала бы этот блок редакционной позицией.
        var top = await db.Comments.AsNoTracking()
            .Where(c => c.BillId != null && c.CreatedAt >= since)
            .GroupBy(c => c.BillId!.Value)
            .Select(g => new { BillId = g.Key, Comments = g.Count() })
            .OrderByDescending(x => x.Comments)
            .Take(BlockSize)
            .ToListAsync();

        if (top.Count == 0)
        {
            _debated = [];
            return;
        }

        var ids = top.Select(t => t.BillId).ToList();
        var names = await db.Bills.AsNoTracking()
            .Where(b => ids.Contains(b.Id))
            .Select(b => new { b.Id, b.Name, b.NameRu })
            .ToListAsync();

        _debated = top
            .Join(names, t => t.BillId, n => n.Id, (t, n) => new DebatedItem(
                n.Id, n.NameRu ?? n.Name, n.NameRu == null, t.Comments))
            .ToList();
    }
}
