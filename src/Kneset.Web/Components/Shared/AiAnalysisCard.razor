@using System.Globalization
@using System.Text.Json
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject IDbContextFactory<AppDbContext> DbFactory
@inject Kneset.Web.Services.AnalysisQueue Queue

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@L["Ai_Header"]</span>
        @if (_analysis is not null)
        {
            <small class="text-muted">
                <span class="badge bg-light text-dark border">@_shownLang.ToUpperInvariant()</span>
                @_generatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @_modelVersion
            </small>
        }
    </div>
    <div class="card-body">
        @if (_loading)
        {
            <div class="text-center p-3"><div class="spinner-border spinner-border-sm"></div></div>
        }
        else if (_analysis is null && TranslationExpected)
        {
            <div class="d-flex align-items-center gap-2 text-muted">
                <div class="spinner-border spinner-border-sm"></div>
                <span>@L["Ai_Generating"]</span>
            </div>
        }
        else if (_analysis is null)
        {
            <p class="text-muted mb-0">@L["Ai_Unavailable"] <button class="btn btn-sm btn-outline-primary" @onclick="RequestAnalysis">@L["Ai_Retry"]</button></p>
        }
        else
        {
            @* Показан не тот язык, который выбран, — говорим об этом всегда,
               а не только пока задача висит в очереди.

               Раньше условие включало _generating, то есть зависело от флага
               очереди в памяти. Флаг теряется при перезапуске приложения
               и не виден другому экземпляру, поэтому человек мог получить
               английский разбор без всякого объяснения — что и случилось:
               мастер сохраняется на английском, перевод приходит через
               минуту, и в это окно страница молчала о причине. *@
            @if (_shownLang != UserLang)
            {
                <div class="alert alert-info py-2 d-flex align-items-center gap-2 flex-wrap">
                    @if (TranslationExpected)
                    {
                        <div class="spinner-border spinner-border-sm"></div>
                    }
                    @* «Готовится» — правда, пока задача в очереди или ещё
                       будет поставлена. Если попытка уже закончилась,
                       а нужного языка так и нет, обещать подготовку нельзя:
                       человек будет ждать напрасно. Тогда — кнопка. *@
                    <span>@L[TranslationExpected ? "Ai_TranslationPending" : "Ai_TranslationMissing"]</span>
                    @if (!TranslationExpected)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="RequestAnalysis">@L["Ai_Retry"]</button>
                    }
                </div>
            }

            <AnalysisView Analysis="_analysis" />

            <hr />
            <small class="text-muted">@L["Ai_Disclaimer"]</small>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int BillId { get; set; }

    private bool _loading = true;
    private bool _generating;
    private BillAnalysisResult? _analysis;
    private DateTime? _generatedAt;
    private string? _modelVersion;
    private string _shownLang = "";
    private bool _polling;
    private readonly CancellationTokenSource _pollCts = new();

    private static string UserLang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    /// <summary>
    /// Перевод на язык пользователя ещё ожидается: либо задача в очереди,
    /// либо компонент пока не интерактивен и поставит её сразу после
    /// подключения цепи. Второе важно: уведомление отрисовывается уже при
    /// пререндере, где запрос ещё не сделан, — и без этой поправки человек
    /// первым делом видел «перевода нет» с кнопкой, хотя перевод вот-вот
    /// начнётся сам.
    /// </summary>
    private bool TranslationExpected => _generating || !RendererInfo.IsInteractive;

    protected override async Task OnParametersSetAsync()
    {
        Queue.Completed += OnAnalysisCompleted;
        await LoadAsync();
        _loading = false;

        // Свежего анализа на языке пользователя нет — ставим в очередь
        // (воркер сам сгенерирует мастер и/или перевод).
        //
        // Только в интерактивном режиме. Этот метод выполняется и при
        // пререндере, а значит поисковый робот, который скачивает HTML
        // и уходит, запускал генерацию, ничего не нажимая: разбор стоит
        // около 0.7 ₪, и обход окна влияния сжигал бы бюджет провайдера
        // на страницах, которые никто не читал.
        //
        // Живой посетитель этого не замечает: пререндер пропускает запуск,
        // цепь Blazor подключается, компонент выполняется снова — уже
        // интерактивно — и генерация начинается сама, без нажатия.
        if (RendererInfo.IsInteractive && (_shownLang != UserLang || _analysis is null))
        {
            RequestAnalysis();

            if (!_polling)
            {
                _polling = true;
                _ = PollUntilTranslatedAsync();
            }
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var fresh = await db.BillAnalyses.AsNoTracking()
            .Where(a => a.BillId == BillId && !a.IsStale)
            .OrderByDescending(a => a.GeneratedAt)
            .ToListAsync();

        // Фолбэк: язык пользователя → английский мастер → любой свежий.
        var entity = fresh.FirstOrDefault(a => a.LanguageCode == UserLang)
                     ?? fresh.FirstOrDefault(a => a.LanguageCode == "en")
                     ?? fresh.FirstOrDefault();

        if (entity is not null)
        {
            try
            {
                _analysis = JsonSerializer.Deserialize<BillAnalysisResult>(entity.AnalysisJson);
                _generatedAt = entity.GeneratedAt;
                _modelVersion = entity.ModelVersion;
                _shownLang = entity.LanguageCode;
            }
            catch (JsonException)
            {
                _analysis = null;
            }
        }
        _generating = Queue.IsPendingAnyLang(BillId);
    }

    private void RequestAnalysis()
    {
        Queue.TryEnqueue(BillId, UserLang);
        _generating = true;
    }

    private void OnAnalysisCompleted(int billId, string lang)
    {
        if (billId != BillId) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Подстраховка к событию очереди: пока нужного языка нет, перечитываем
    /// базу раз в пять секунд.
    ///
    /// Событие Completed живёт в памяти процесса. Оно теряется, если
    /// приложение перезапустилось за время генерации (на бесплатном тарифе
    /// Render это обычное дело) или если разбор посчитал другой экземпляр.
    /// Тогда перевод уже лежит в базе, а страница о нём не знает —
    /// и человеку приходится перезагружать вручную, о чём и был отзыв.
    ///
    /// Опрос стоит один короткий запрос в базу и живёт только пока ждём;
    /// потолок нужен, чтобы забытая открытая вкладка не стучала вечно.
    /// </summary>
    private async Task PollUntilTranslatedAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        var deadline = DateTime.UtcNow.AddMinutes(5);

        try
        {
            while (DateTime.UtcNow < deadline && await timer.WaitForNextTickAsync(_pollCts.Token))
            {
                await LoadAsync();
                StateHasChanged();
                if (_analysis is not null && _shownLang == UserLang) return;
            }
        }
        catch (OperationCanceledException)
        {
            // Страницу закрыли — ждать больше некому.
        }
        finally
        {
            _polling = false;
        }
    }

    public void Dispose()
    {
        Queue.Completed -= OnAnalysisCompleted;
        _pollCts.Cancel();
        _pollCts.Dispose();
    }
}
