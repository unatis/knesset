@using System.Globalization
@using Kneset.Web.Localization

<!DOCTYPE html>
<html lang="@Lang" dir="@Dir">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Базовый адрес — с языком: «/ru/». Так относительные ссылки и статика
       уходят под префикс сами, а хаб «/_blazor» находится под PathBase.
       Ниже — те же страницы на других языках для поисковиков и ответных
       машин; x-default ведёт на адрес без языка, где выбор делается
       по предпочтению читателя. *@
    <base href="@BaseHref" />
    @if (HttpContext is not null)
    {
        foreach (var culture in CulturePath.Supported)
        {
            <link rel="alternate" hreflang="@culture" href="@Absolute(culture)" />
        }
        <link rel="alternate" hreflang="x-default" href="@Absolute(null)" />
        <link rel="canonical" href="@Absolute(Lang)" />
    }
    <ResourcePreloader />
    @if (Dir == "rtl")
    {
        <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.rtl.min.css"]" />
    }
    else
    {
        <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    }
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Kneset.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* HeadOutlet ПЕРЕД дефолтными og-тегами: краулеры берут первый og:image,
       поэтому страничные теги (HeadContent) должны идти раньше. *@
    <HeadOutlet />
    <meta property="og:site_name" content="Kneset Tracker" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-cover.png" />
    <meta name="twitter:card" content="summary_large_image" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/share.js"></script>
    <script src="js/dropdown.js"></script>
</body>

</html>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private static string Lang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private static string Dir => Lang is "he" or "ar" ? "rtl" : "ltr";

    private string BaseHref => (HttpContext?.Request.PathBase.Value ?? "") + "/";

    /// <summary>
    /// Тот же путь и запрос на указанном языке; null — адрес без языка.
    /// Схема и хост — из запроса: за прокси Render их восстанавливает
    /// UseForwardedHeaders, и это надёжнее зашитого адреса.
    /// </summary>
    private string Absolute(string? culture)
    {
        var request = HttpContext!.Request;
        var prefix = culture is null ? "" : "/" + culture;
        return $"{request.Scheme}://{request.Host}{prefix}{request.Path.Value}{request.QueryString}";
    }
}
