@implements IDisposable
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

@* Разделы сайта. Колокольчик и переключатель языка живут в верхней панели,
   чтобы не дублироваться. *@

<nav class="nav flex-column py-3">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="nav-icon" aria-hidden="true">🏠</span> @L["Nav_Home"]
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="bills">
            <span class="nav-icon" aria-hidden="true">📜</span> @L["Nav_Bills"]
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="members">
            <span class="nav-icon" aria-hidden="true">🧑‍⚖️</span> @L["Nav_Members"]
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="initiatives">
            <span class="nav-icon" aria-hidden="true">💡</span> @L["Nav_Initiatives"]
        </NavLink>
    </div>

    <AuthorizeView>
        <Authorized>
            <hr class="nav-divider" />

            <div class="nav-item">
                <NavLink class="nav-link" href="notifications">
                    <span class="nav-icon" aria-hidden="true">🔔</span> @L["Nav_Notifications"]
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="settings/notifications">
                    <span class="nav-icon" aria-hidden="true">⚙️</span> @L["Notif_Settings"]
                </NavLink>
            </div>

            <div class="nav-item">
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-link nav-link-button">
                        <span class="nav-icon" aria-hidden="true">🚪</span> @L["Nav_Logout"]
                    </button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <hr class="nav-divider" />

            <div class="nav-item">
                <NavLink class="nav-link" href="Account/Register">
                    <span class="nav-icon" aria-hidden="true">✍️</span> @L["Nav_Register"]
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Account/Login">
                    <span class="nav-icon" aria-hidden="true">🔑</span> @L["Nav_Login"]
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
