@implements IDisposable
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

@* Разделы сайта. Колокольчик и переключатель языка живут в верхней панели,
   чтобы не дублироваться.

   Визуальный слой: emoji-иконки убраны. Они рендерились по-разному в каждой ОС
   и ломали вертикальный ритм строки; в меню из шести пунктов подписи справляются
   сами. Если позже понадобятся иконки — Lucide через CDN, обводка 1.75, 20px. *@

<nav class="nav flex-column py-3">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">@L["Nav_Home"]</NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="bills">@L["Nav_Bills"]</NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="laws">@L["Nav_Laws"]</NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="members">@L["Nav_Members"]</NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="initiatives">@L["Nav_Initiatives"]</NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="about">@L["Nav_About"]</NavLink>
    </div>

    <AuthorizeView>
        <Authorized>
            <hr class="nav-divider" />

            <div class="nav-item">
                <NavLink class="nav-link" href="notifications">@L["Nav_Notifications"]</NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="settings/notifications">@L["Notif_Settings"]</NavLink>
            </div>

            <div class="nav-item">
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-link nav-link-button">@L["Nav_Logout"]</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <hr class="nav-divider" />

            <div class="nav-item">
                <NavLink class="nav-link" href="Account/Register">@L["Nav_Register"]</NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Account/Login">@L["Nav_Login"]</NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
