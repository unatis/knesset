@page "/laws"
@rendermode InteractiveServer
@using Kneset.Core.Entities
@using System.Globalization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Laws_Title"]</PageTitle>

<h2>@L["Laws_Title"]</h2>
<p class="text-muted">@L["Laws_Lead"]</p>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <input class="form-control" style="max-width:360px" placeholder="@L["Laws_Search"]"
           value="@_search" @oninput="OnSearchChanged" />
    <select class="form-select" style="max-width:280px" value="@_topic"
            @onchange="OnTopicChanged" aria-label="@L["Laws_Topic"]">
        <option value="">@L["Laws_AllTopics"]</option>
        @foreach (var t in _topics)
        {
            <option value="@t.Id">@t.Name</option>
        }
    </select>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="basicOnly"
               checked="@_basicOnly" @onchange="OnBasicChanged" />
        <label class="form-check-label" for="basicOnly">@L["Laws_BasicOnly"]</label>
    </div>
</div>

@if (_laws is null)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else if (_total == 0)
{
    <div class="alert alert-light border">@L["Laws_Empty"]</div>
}
else
{
    <p class="text-muted">@L["Laws_Found"]: @_total</p>

    <ul class="list-group">
        @foreach (var row in _laws)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        @* Оформление как в списке законопроектов: заголовок
                           блочный, с unicode-bidi: plaintext. С dir="rtl"
                           иврит прижимался к правому краю и отрывался
                           от колонки. *@
                        <div class="kt-row-title" lang="he">
                            <a href="/laws/@row.Law.Id">@row.Law.Name</a>
                        </div>
                        @if (row.Translated is { } translated)
                        {
                            @* Оригинал первой строкой: название закона — формула,
                               на которую ссылаются другие законы и суды. *@
                            <div class="kt-row-orig">@translated</div>
                        }
                    </div>
                    <div class="text-end flex-shrink-0">
                        @if (row.Law.IsBasicLaw)
                        {
                            <span class="badge bg-dark">@L["Laws_BasicLaw"]</span>
                        }
                        @if (row.IndirectCount > 0)
                        {
                            @* Косвенные поправки — то, ради чего этот раздел и делался. *@
                            <span class="badge bg-warning text-dark">
                                @string.Format(L["Laws_IndirectCount"], row.IndirectCount)
                            </span>
                        }
                    </div>
                </div>
                @if (row.Topics.Count > 0)
                {
                    @* Рубрикатор Кнессета, а не наша классификация. *@
                    <div class="kt-law-topics">
                        @foreach (var t in row.Topics)
                        {
                            <span class="kt-law-topic">@t</span>
                        }
                    </div>
                }

                <small class="text-muted">
                    @row.Law.ValidityDesc
                    @if (row.Law.ValidityStartDate is not null)
                    {
                        <span> · @L["Laws_InForceSince"] @row.Law.ValidityStartDate.Value.ToString("dd.MM.yyyy")</span>
                    }
                </small>
            </li>
        }
    </ul>

    @if (_total > PageSize)
    {
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item @(_page == 0 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToAsync(_page - 1)">←</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@(_page + 1) / @((_total + PageSize - 1) / PageSize)</span>
                </li>
                <li class="page-item @((_page + 1) * PageSize >= _total ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToAsync(_page + 1)">→</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private const int PageSize = 25;

    private sealed record LawRow(IsraelLaw Law, int IndirectCount, string? Translated,
                                List<string> Topics);

    private sealed record TopicOption(int Id, string Name);

    private List<LawRow>? _laws;
    private int _total;
    private int _page;
    private string _search = "";
    private bool _basicOnly;
    private string _topic = "";
    private List<TopicOption> _topics = [];
    private System.Timers.Timer? _debounce;

    /// <summary>Тема из адреса: со страницы закона переходят прямо в отбор по теме.</summary>
    [SupplyParameterFromQuery(Name = "topic")]
    private int? TopicQuery { get; set; }

    protected override Task OnInitializedAsync()
    {
        if (TopicQuery is { } t) _topic = t.ToString();
        return LoadAsync();
    }

    private bool _topicsLoaded;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.IsraelLaws.AsNoTracking();

        // Иврит — оригинал в Name, переводить его некуда и незачем.
        var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var translate = lang != "he";

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var pattern = $"%{_search.Trim()}%";
            // Искать только по ивритскому оригиналу значило бы, что читатель
            // не может найти закон теми же словами, которыми его видит.
            query = query.Where(l =>
                EF.Functions.ILike(l.Name, pattern) ||
                (translate && l.Titles.Any(t => t.LanguageCode == lang
                                                && EF.Functions.ILike(t.Text, pattern))));
        }

        if (_basicOnly) query = query.Where(l => l.IsBasicLaw);

        if (int.TryParse(_topic, out var topicId))
            query = query.Where(l => l.Topics.Any(t => t.TopicId == topicId));

        if (!_topicsLoaded)
        {
            await LoadTopicsAsync(db);
            _topicsLoaded = true;
        }

        _total = await query.CountAsync();

        var laws = await query
            .OrderByDescending(l => l.IsBasicLaw)
            .ThenByDescending(l => l.ValidityStartDate)
            .Skip(_page * PageSize).Take(PageSize)
            .ToListAsync();

        // Счётчик косвенных поправок одним запросом по показанным законам.
        var ids = laws.Select(l => l.Id).ToList();
        var indirect = await db.LawAmendments.AsNoTracking()
            .Where(a => ids.Contains(a.IsraelLawId) && a.IsIndirect)
            .GroupBy(a => a.IsraelLawId)
            .Select(g => new { IsraelLawId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.IsraelLawId, x => x.Count);

        // Переводы названий — одним запросом по показанной странице.
        var titles = translate
            ? await db.IsraelLawTitles.AsNoTracking()
                .Where(t => ids.Contains(t.IsraelLawId) && t.LanguageCode == lang)
                .ToDictionaryAsync(t => t.IsraelLawId, t => t.Text)
            : [];

        var topics = await db.LawTopics.AsNoTracking()
            .Where(t => ids.Contains(t.IsraelLawId))
            .Select(t => new { t.IsraelLawId, t.TopicId, t.NameHe })
            .ToListAsync();

        var byLaw = topics
            .GroupBy(t => t.IsraelLawId)
            .ToDictionary(g => g.Key,
                          g => g.Select(t => TopicNaming.Localized(L, t.TopicId, t.NameHe))
                                .OrderBy(x => x, StringComparer.CurrentCulture)
                                .ToList());

        _laws = laws
            .Select(l => new LawRow(l, indirect.GetValueOrDefault(l.Id),
                                    titles.GetValueOrDefault(l.Id),
                                    byLaw.GetValueOrDefault(l.Id) ?? []))
            .ToList();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 0;
        _debounce?.Stop();
        _debounce = new System.Timers.Timer(350) { AutoReset = false };
        _debounce.Elapsed += async (_, _) => await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
        _debounce.Start();
    }


    /// <summary>
    /// Справочник для селекта — только темы, которые действительно есть
    /// у законов: пустой пункт фильтра обещает результат, которого нет.
    /// </summary>
    private async Task LoadTopicsAsync(AppDbContext db)
    {
        var raw = await db.LawTopics.AsNoTracking()
            .Select(t => new { t.TopicId, t.NameHe })
            .Distinct()
            .ToListAsync();

        _topics = raw
            .GroupBy(t => t.TopicId)
            .Select(g => new TopicOption(g.Key, TopicNaming.Localized(L, g.Key, g.First().NameHe)))
            .OrderBy(t => t.Name, StringComparer.CurrentCulture)
            .ToList();
    }

    private async Task OnTopicChanged(ChangeEventArgs e)
    {
        _topic = e.Value?.ToString() ?? "";
        _page = 0;
        await LoadAsync();
    }

    private async Task OnBasicChanged(ChangeEventArgs e)
    {
        _basicOnly = (bool)(e.Value ?? false);
        _page = 0;
        await LoadAsync();
    }

    private async Task GoToAsync(int page)
    {
        _page = Math.Max(0, page);
        await LoadAsync();
    }
}
