@page "/bills"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav_Bills"]</PageTitle>

<h1>@L["Nav_Bills"]</h1>

@* Визуальный слой: list-group заменён на строки с разделителями (.kt-row).
   Карточка внутри карточки съедала около 40% плотности списка.
   Порядок заголовков перевёрнут: сначала название на языке интерфейса,
   оригинал на иврите — второй строкой. Данные те же (NameRu / Name). *@

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" placeholder="@L["Bills_Search"]"
               value="@_search" @oninput="OnSearchChanged" />
    </div>
    <div class="col-md-3">
        <select class="form-select" value="@_statusFilter" @onchange="OnStatusChanged">
            <option value="">@L["Bills_AllStatuses"]</option>
            @foreach (var status in _statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" value="@_knessetFilter" @onchange="OnKnessetChanged">
            <option value="">@L["Bills_AllKnessets"]</option>
            @foreach (var num in _knessetNums)
            {
                <option value="@num">@L["Knesset"] @num</option>
            }
        </select>
    </div>
</div>

@* Фракция и депутат связаны: выбор фракции сужает список имён. Иначе
   в селекте полторы сотни строк на иврите, и найти в них нужного человека
   тяжелее, чем вспомнить его партию. Показываем только действующих —
   в Persons лежат все, кто когда-либо был в Кнессете. *@
<div class="row g-2 mb-3">
    <div class="col-md-4">
        <select class="form-select" value="@_factionFilter" @onchange="OnFactionChanged">
            <option value="">@L["Bills_AllFactions"]</option>
            @foreach (var faction in _factions)
            {
                <option value="@faction">@faction</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <select class="form-select" value="@_personFilter" @onchange="OnPersonChanged">
            <option value="">@L["Bills_AllMembers"]</option>
            @foreach (var person in VisibleMembers)
            {
                <option value="@person.Id">@person.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-center">
        @* На законе бывает четыре десятка инициаторов: подписанты попадают
           в выборку наравне с тем, кто закон внёс. Переключатель оставляет
           выбор человеку, а не решает за него, кого считать автором. *@
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="authorOnly"
                   checked="@_authorOnly" @onchange="OnAuthorOnlyChanged"
                   disabled="@(string.IsNullOrEmpty(_personFilter) && string.IsNullOrEmpty(_factionFilter))" />
            <label class="form-check-label" for="authorOnly">@L["Bills_AuthorOnly"]</label>
        </div>
    </div>
</div>

@if (_bills is null)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else if (_bills.Count == 0)
{
    <div class="alert alert-info">@L["Bills_Empty"]</div>
}
else
{
    <p class="kt-num">@L["Bills_Found"] @_totalCount</p>

    <div class="kt-rows mb-3">
        @foreach (var bill in _bills)
        {
            <a href="/bills/@bill.Bill.Id" class="kt-row">
                <div class="kt-row-main">
                    @if (bill.Bill.NameRu is not null)
                    {
                        <div class="kt-row-title">@bill.Bill.NameRu</div>
                        <div class="kt-row-orig" lang="he">@bill.Bill.Name</div>
                    }
                    else
                    {
                        <div class="kt-row-title" lang="he">@bill.Bill.Name</div>
                    }

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <InfluenceWindowBadge StatusDesc="@bill.Bill.StatusDesc" />
                        <span class="kt-num">
                            @L["Knesset"] @bill.Bill.KnessetNum
                            @if (bill.Bill.SubTypeDesc is not null)
                            {
                                <span> · <span dir="rtl" lang="he">@bill.Bill.SubTypeDesc</span></span>
                            }
                            @* Показываем ту дату, по которой список и отсортирован.
                               Прежнее «обновлён» — это LastUpdatedDate, отметка
                               Кнессета о правке записи: после массовой синхронизации
                               она одинакова у тысяч законов и ни о чём не говорит. *@
                            @if (bill.Bill.FirstSessionAt is { } inAgenda)
                            {
                                <span> · @L["Bills_InAgendaSince"] @inAgenda.ToString("dd.MM.yyyy")</span>
                            }
                            else
                            {
                                <span> · @L["Updated"] @bill.Bill.LastUpdatedDate.ToString("dd.MM.yyyy")</span>
                            }
                        </span>
                    </div>
                </div>

                @if (bill.Support + bill.Oppose + bill.Undecided > 0)
                {
                    <div class="kt-row-side">
                        <ReactionBar Support="@bill.Support" Oppose="@bill.Oppose"
                                     Undecided="@bill.Undecided" Compact="true" />
                    </div>
                }
            </a>
        }
    </div>

    <nav>
        <ul class="pagination">
            <li class="page-item @(_page == 0 ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(_page - 1)">←</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@L["Page"] @(_page + 1) @L["Of"] @Math.Max(1, (_totalCount + PageSize - 1) / PageSize)</span>
            </li>
            <li class="page-item @((_page + 1) * PageSize >= _totalCount ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(_page + 1)">→</button>
            </li>
        </ul>
    </nav>
}

@code {
    private const int PageSize = 25;

    private List<BillRow>? _bills;

    private record BillRow(Bill Bill, int Support, int Oppose, int Undecided);
    private int _totalCount;
    private int _page;
    private string _search = "";
    private string _statusFilter = "";
    private string _knessetFilter = "";
    private string _factionFilter = "";
    private string _personFilter = "";

    /// <summary>Считать ли только внесённые законы, без подписанных.</summary>
    private bool _authorOnly;

    private sealed record MemberOption(int Id, string Name, string? Faction);

    private List<string> _factions = [];
    private List<MemberOption> _members = [];

    /// <summary>Депутаты, подходящие под выбранную фракцию.</summary>
    private IEnumerable<MemberOption> VisibleMembers =>
        string.IsNullOrEmpty(_factionFilter)
            ? _members
            : _members.Where(m => m.Faction == _factionFilter);
    private List<string> _statuses = [];
    private List<int> _knessetNums = [];
    private System.Timers.Timer? _debounce;

    /// <summary>Запрос из строки адреса — сюда приходит поиск из верхней панели.</summary>
    /// <summary>Депутат из адреса — сюда ведёт ссылка с его карточки.</summary>
    [SupplyParameterFromQuery(Name = "personId")]
    private int? PersonQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Query)) _search = Query;
        if (PersonQuery is { } pid) _personFilter = pid.ToString();

        await using var db = await DbFactory.CreateDbContextAsync();
        _statuses = await db.Bills.Where(b => b.StatusDesc != null)
            .Select(b => b.StatusDesc!).Distinct().OrderBy(s => s).ToListAsync();

        // Только действующие: в Persons лежат все, кто когда-либо был в Кнессете,
        // и список из сотен имён в селекте бесполезен.
        _members = (await db.Persons.AsNoTracking()
                .Where(x => x.IsCurrent)
                .Select(x => new { x.Id, x.FirstName, x.LastName, x.FactionName })
                .ToListAsync())
            .Select(x => new MemberOption(x.Id, $"{x.FirstName} {x.LastName}".Trim(), x.FactionName))
            .OrderBy(x => x.Name, StringComparer.CurrentCulture)
            .ToList();

        _factions = _members
            .Where(m => !string.IsNullOrEmpty(m.Faction))
            .Select(m => m.Faction!)
            .Distinct()
            .OrderBy(x => x, StringComparer.CurrentCulture)
            .ToList();
        _knessetNums = await db.Bills.Select(b => b.KnessetNum).Distinct()
            .OrderByDescending(n => n).ToListAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Bills.AsNoTracking();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var pattern = $"%{_search.Trim()}%";
            query = query.Where(b =>
                EF.Functions.ILike(b.Name, pattern) ||
                (b.NameRu != null && EF.Functions.ILike(b.NameRu, pattern)));
        }
        if (!string.IsNullOrEmpty(_statusFilter))
            query = query.Where(b => b.StatusDesc == _statusFilter);
        // Отбор по депутату и фракции идёт через таблицу инициаторов.
        // IsInitiator отделяет внёсшего закон от подписантов: на одном законе
        // их бывает четыре десятка, и без этого различия «законы депутата»
        // показывали бы в основном чужие инициативы, которые он поддержал.
        if (int.TryParse(_personFilter, out var personId))
        {
            query = query.Where(b => b.Initiators.Any(i =>
                i.PersonId == personId && (!_authorOnly || i.IsInitiator)));
        }
        else if (!string.IsNullOrEmpty(_factionFilter))
        {
            var faction = _factionFilter;
            query = query.Where(b => b.Initiators.Any(i =>
                i.Person.FactionName == faction && (!_authorOnly || i.IsInitiator)));
        }

        if (int.TryParse(_knessetFilter, out var knesset))
            query = query.Where(b => b.KnessetNum == knesset);

        _totalCount = await query.CountAsync();
        _bills = await query
            // Сортируем по дате первого появления в повестке заседания, а не по
            // LastUpdatedDate: последняя — отметка «когда запись тронул Кнессет»,
            // и после массовой синхронизации она одинакова у тысяч законов.
            // На первой странице все 25 строк были от одного числа, то есть
            // сортировка формально работала, а сравнивать было нечего.
            // FirstSessionAt заполняется синхронизацией из BillSession; у законов,
            // ни разу не попавших в повестку, его нет — для них берём момент,
            // когда мы впервые их увидели.
            .OrderByDescending(b => b.FirstSessionAt ?? b.FirstSeenAt)
            // Вторичный ключ обязателен. Без него равные даты дают неопределённый
            // порядок, а Skip/Take по неопределённому порядку — это строки,
            // способные повториться на соседних страницах или пропасть совсем.
            .ThenByDescending(b => b.Id)
            .Skip(_page * PageSize).Take(PageSize)
            .Select(b => new BillRow(
                b,
                b.Reactions.Count(r => r.Kind == ReactionKind.Support),
                b.Reactions.Count(r => r.Kind == ReactionKind.Oppose),
                b.Reactions.Count(r => r.Kind == ReactionKind.Undecided)))
            .ToListAsync();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(400) { AutoReset = false };
        _debounce.Elapsed += async (_, _) => await InvokeAsync(async () =>
        {
            _page = 0;
            await LoadAsync();
            StateHasChanged();
        });
        _debounce.Start();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "";
        _page = 0;
        await LoadAsync();
    }

    private async Task OnKnessetChanged(ChangeEventArgs e)
    {
        _knessetFilter = e.Value?.ToString() ?? "";
        _page = 0;
        await LoadAsync();
    }

    private async Task OnFactionChanged(ChangeEventArgs e)
    {
        _factionFilter = e.Value?.ToString() ?? "";

        // Выбранный депутат мог оказаться из другой фракции — сбрасываем,
        // иначе фильтры противоречили бы друг другу молча.
        if (!string.IsNullOrEmpty(_personFilter)
            && !VisibleMembers.Any(m => m.Id.ToString() == _personFilter))
            _personFilter = "";

        _page = 0;
        await LoadAsync();
    }

    private async Task OnPersonChanged(ChangeEventArgs e)
    {
        _personFilter = e.Value?.ToString() ?? "";
        _page = 0;
        await LoadAsync();
    }

    private async Task OnAuthorOnlyChanged(ChangeEventArgs e)
    {
        _authorOnly = e.Value is true;
        _page = 0;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        _page = Math.Max(0, page);
        await LoadAsync();
    }
}
