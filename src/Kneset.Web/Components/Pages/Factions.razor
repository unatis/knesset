@page "/factions"
@using System.Globalization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L
@inject Kneset.Web.Services.CurrentKnessetService CurrentKnesset

<PageTitle>@L["Factions_Title"]</PageTitle>

@* Карта политического расклада.

   Страница нарочно без InteractiveServer: она только читает и должна
   попадать в поисковую выдачу целиком, а не пререндером с догрузкой.

   Схема читается сверху вниз: сначала кубики партий, потом то, во что
   они сложились. Порядок не косметический — партия существует вне
   Кнессета и переживает выборы, а фракция живёт только внутри созыва
   и составляется из партий.

   Форм две, и они разные по смыслу:
   объединение — несколько партий сходятся в одну фракцию;
   раскол — общий список или фракция расходится на несколько.
   Направление показывают стрелки на концах линий. *@

@if (_units is null)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else
{
    <div class="kt-fmap">
        <header class="kt-fmap-head">
            @if (_knessetNum is { } num)
            {
                <div class="kt-eyebrow">@L["Knesset"] @num</div>
            }
            <h1>@L["Factions_Title"]</h1>
            <div class="kt-fmap-counts">
                <span><b>@_totalSeats</b> @L["Factions_Mandates"]</span>
                <span class="kt-fmap-dot">·</span>
                <span><b>@_factionCount</b> @L["Factions_FactionCount"]</span>
                <span class="kt-fmap-dot">·</span>
                <span><b>@_totalParties</b> @L["Factions_PartyCount"]</span>
            </div>
            <p class="kt-fmap-lead">@L["Factions_Lead"]</p>
        </header>

        @* Полоса: доля мандатов честно шириной, без выдуманных долей
           по партиям — их в данных нет. *@
        <section class="kt-fmap-strip-wrap">
            <div class="kt-fmap-strip-head">
                <span class="kt-eyebrow">@L["Factions_StripTitle"]</span>
                <span class="kt-fmap-hint">@L["Factions_StripHint"]</span>
            </div>

            @* Читатель должен видеть, на что он смотрит: 25-й созыв
               завершился 17 июля 2026, и его состав — уже история,
               а не сегодняшний расклад. Обе даты берутся из данных
               Кнессета (KNS_KnessetDates), не вписаны руками. *@
            @if (_term is not null)
            {
                <div class="kt-fmap-when">
                    <span>@L["Factions_Term"] @_term.Id</span>
                    <span class="kt-fmap-dot">·</span>
                    @* Диапазон собирается в коде: между выражениями Razor
                       съедает перенос строки, и без этого выходило «2022—». *@
                    <span>@TermRange(_term)</span>
                    @if (_term.FinishDate is { } finish && finish < DateOnly.FromDateTime(DateTime.UtcNow))
                    {
                        <span class="kt-fmap-ended">@L["Factions_TermEnded"]</span>
                    }
                    @if (_syncedAt is { } synced)
                    {
                        <span class="kt-fmap-dot">·</span>
                        <span>@L["Factions_AsOf"] @Day(synced)</span>
                    }
                </div>
            }
            <div class="kt-fmap-strip">
                @foreach (var f in _strip!)
                {
                    <div class="kt-fmap-seg @(f.Parties.Count > 1 ? "kt-hatch" : "") kt-kind-@f.Kind"
                         style="flex-grow: @f.Seats" title="@f.Name">
                        @if (f.Seats >= 4)
                        {
                            <span>@f.Seats</span>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="kt-fmap-units">
            @foreach (var u in _units)
            {
                <div class="kt-fmap-unit kt-kind-@u.Kind" style="--kt-slots: @u.Slots">
                    @if (u.GroupKey is { Length: > 0 })
                    {
                        <div class="kt-fmap-grouphead">
                            <span class="kt-fmap-grouptitle">@L[$"FactionGroup_{u.GroupKey}"]</span>
                            @if (u.GroupDate is { } date)
                            {
                                <span class="kt-fmap-date">@date.ToString("d MMMM yyyy", CultureInfo.CurrentUICulture)</span>
                            }
                        </div>
                    }

                    @* Уровень партий рисуется только когда он что-то добавляет:
                       у одиннадцати фракций из тринадцати партия называется
                       так же, как фракция, и «Ликуд сформирована из Ликуд» —
                       чистый шум. Подробности начинаются там, где партий
                       несколько или имя партии отличается от имени фракции. *@
                    @if (u.ShowParties)
                    {
                        <div class="kt-fmap-level">
                            @foreach (var party in u.Parties)
                            {
                                <div class="kt-fmap-party">
                                    <span class="kt-eyebrow">@L["Factions_PartyOne"]</span>
                                    <b dir="@(party.IsHebrew ? "rtl" : null)"
                                       lang="@(party.IsHebrew ? "he" : null)">@party.Name</b>
                                </div>
                            }
                        </div>

                        @* Объединение: линии от партий сходятся в одно *@
                        <div class="kt-fmap-join">
                            <div class="kt-fmap-legs is-up">
                                @for (var i = 0; i < u.Parties.Count; i++)
                                {
                                    <div class="kt-fmap-leg @(i == 0 ? "is-first" : "") @(i == u.Parties.Count - 1 ? "is-last" : "")"></div>
                                }
                            </div>
                            <div class="kt-fmap-stem"><span class="kt-fmap-arrow"></span></div>
                        </div>
                    }

                    @if (u.OriginName is { Length: > 0 })
                    {
                        @* Уровень 2 — чем эти партии были вместе до раскола *@
                        @* Подпись типа обязательна: без неё коробка посередине
                           читалась как непонятно что — «это партия? фракция?
                           так и называется?». Список на выборах и фракция —
                           разные вещи, и коробка должна говорить, что она. *@
                        <div class="kt-fmap-origin">
                            <span class="kt-eyebrow">@L[$"FactionGroupKind_{u.GroupKey}"]</span>
                            <b>@u.OriginName</b>
                            @if (u.OriginNote is { Length: > 0 })
                            {
                                <small>@u.OriginNote</small>
                            }
                        </div>

                        @* Раскол: одна линия расходится на несколько *@
                        <div class="kt-fmap-split">
                            <div class="kt-fmap-stem"></div>
                            <div class="kt-fmap-legs is-down">
                                @for (var i = 0; i < u.Factions.Count; i++)
                                {
                                    <div class="kt-fmap-leg @(i == 0 ? "is-first" : "") @(i == u.Factions.Count - 1 ? "is-last" : "")">
                                        <span class="kt-fmap-arrow"></span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Уровень 3 — фракции *@
                    <div class="kt-fmap-level">
                        @foreach (var f in u.Factions)
                        {
                            <article class="kt-fmap-card">
                                <div class="kt-fmap-seats">
                                    <b>@f.Seats</b>
                                    <span>@SeatWord(f.Seats)</span>
                                </div>
                                <h2 class="kt-fmap-name">@f.Name</h2>
                                @if (f.Note is { Length: > 0 })
                                {
                                    <p class="kt-fmap-note">@f.Note</p>
                                }
                            </article>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="kt-fmap-legend">
            <span class="kt-eyebrow">@L["Factions_HowToRead"]</span>
            <div class="kt-fmap-legend-items">
                <div class="kt-fmap-legend-item">
                    <span class="kt-fmap-swatch kt-kind-single"></span>
                    <span><b>@L["Factions_KindSingle"]</b><small>@L["Factions_KindSingleNote"]</small></span>
                </div>
                <div class="kt-fmap-legend-item">
                    <span class="kt-fmap-swatch kt-kind-joint"></span>
                    <span><b>@L["Factions_KindJoint"]</b><small>@L["Factions_KindJointNote"]</small></span>
                </div>
                <div class="kt-fmap-legend-item">
                    <span class="kt-fmap-swatch kt-kind-split"></span>
                    <span><b>@L["Factions_KindSplit"]</b><small>@L["Factions_KindSplitNote"]</small></span>
                </div>
                <div class="kt-fmap-legend-item">
                    <span class="kt-fmap-corner"></span>
                    <span><b>@L["Factions_LineTitle"]</b><small>@L["Factions_LineNote"]</small></span>
                </div>
            </div>
        </section>

        @* Флексом с зазором, а не текстом подряд: между выражениями Razor
           съедает пробелы, и выходило «вручную.сверен». *@
        <footer class="kt-fmap-source">
            <span>@L["Factions_Source"]</span>
            @if (_verifiedAt is { } v)
            {
                <span>@L["Factions_Verified"] @Day(v).</span>
            }
            @* Ссылка на источник, чтобы читатель мог проверить, а не верить
               на слово: это тот же сервис, из которого мы синхронизируемся. *@
            <a href="https://knesset.gov.il/Odata/ParliamentInfo.svc/"
               target="_blank" rel="noopener">@L["Factions_SourceLink"]</a>
        </footer>
    </div>
}

@code {
    private List<Unit>? _units;
    private List<Card>? _strip;
    private int _totalSeats;
    private int _totalParties;
    private int _factionCount;
    private DateOnly? _verifiedAt;
    private int? _knessetNum;
    private KnessetTerm? _term;
    private DateOnly? _syncedAt;

    private record Party(string Name, bool IsHebrew);

    private record Card(int Id, string Name, int Seats, string Kind,
                        List<Party> Parties, string? Note);

    /// <summary>
    /// Единица схемы: партии сверху, фракции снизу, а между ними — либо
    /// прямое объединение, либо ещё и то общее, что потом раскололось.
    /// </summary>
    private record Unit(string Kind, List<Party> Parties, List<Card> Factions,
                        string? GroupKey = null, DateOnly? GroupDate = null,
                        string? OriginName = null, string? OriginNote = null)
    {
        /// <summary>Ширина в колонках — по самому широкому уровню.</summary>
        public int Slots => Math.Max(ShowParties ? Parties.Count : 1, Factions.Count);

        /// <summary>
        /// Есть ли смысл показывать уровень партий. Нет, если у каждой
        /// фракции ровно одна партия и она называется так же: тогда
        /// повторять нечего. Да, если партий несколько или имя партии
        /// расходится с именем фракции — а это и есть содержание карты.
        /// </summary>
        public bool ShowParties =>
            Parties.Count != Factions.Count
            || Parties.Zip(Factions).Any(pair => pair.First.Name != pair.Second.Name);
    }

    protected override async Task OnInitializedAsync()
    {
        _knessetNum = await CurrentKnesset.GetAsync();

        await using var db = await DbFactory.CreateDbContextAsync();

        // Мандаты считаются из состава: фиксировать их в курируемом слое
        // нельзя — они меняются при каждом расколе.
        var seats = await db.Persons.AsNoTracking()
            .Where(p => p.IsCurrent && p.FactionId != null)
            .GroupBy(p => p.FactionId!.Value)
            .Select(g => new { FactionId = g.Key, Seats = g.Count() })
            .ToDictionaryAsync(x => x.FactionId, x => x.Seats);

        var curated = await db.Factions.AsNoTracking()
            .Include(f => f.Parties)
            .ToDictionaryAsync(f => f.Id);

        // Границы созыва — из данных Кнессета; если созыва с таким номером
        // ещё не синхронизировали, строка просто не показывается.
        _term = await db.KnessetTerms.AsNoTracking()
            .FirstOrDefaultAsync(t => t.Id == _knessetNum);

        // «Данные на» — время последней успешной синхронизации фракций,
        // а не время открытия страницы: показывать надо возраст данных.
        var lastSync = await db.SyncLogs.AsNoTracking()
            .Where(l => l.EntityName == "Factions" && l.Error == null && l.FinishedUtc != null)
            .MaxAsync(l => (DateTime?)l.StartedUtc);
        _syncedAt = lastSync is { } ls ? DateOnly.FromDateTime(ls) : null;

        _verifiedAt = curated.Values.Max(f => f.VerifiedAt);
        _totalSeats = seats.Values.Sum();

        var ru = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru";

        var cards = seats.Keys.Select(id =>
        {
            curated.TryGetValue(id, out var c);

            var parties = (c?.Parties ?? [])
                .OrderBy(p => p.Ordinal)
                .Select(p => ru && p.NameRu is { Length: > 0 }
                    ? new Party(p.NameRu, false)
                    : new Party(p.NameHe, true))
                .ToList();

            var note = L[$"FactionNote_{id}"];

            return new Card(
                id,
                // Название фракции уже переведено ключом Faction_<id>;
                // если ключа нет, показываем иврит из курируемого слоя.
                Name: Localized($"Faction_{id}") ?? c?.NameHe ?? id.ToString(),
                Seats: seats[id],
                Kind: c?.OriginKind ?? "single",
                Parties: parties,
                Note: note.ResourceNotFound ? null : note.Value);
        }).ToList();

        _factionCount = cards.Count;
        _totalParties = cards.Sum(c => Math.Max(c.Parties.Count, 1));
        _strip = cards.OrderByDescending(c => c.Seats).ToList();

        // Связанные фракции идут одной единицей: только так между ними
        // можно провести линию. Единица занимает место своей крупнейшей
        // фракции, поэтому порядок остаётся примерно по величине.
        _units = cards
            .GroupBy(c => curated.TryGetValue(c.Id, out var f) ? f.GroupKey : null)
            .SelectMany(g => g.Key is null
                ? g.Select(c => new Unit(c.Kind, c.Parties, [c]))
                : [BuildGroup(g.Key, [.. g], curated)])
            .OrderByDescending(u => u.Factions.Max(c => c.Seats))
            .ToList();
    }

    private Unit BuildGroup(string key, List<Card> members, Dictionary<int, Faction> curated)
    {
        var ordered = members.OrderBy(c => curated[c.Id].GroupOrdinal).ToList();
        return new Unit(
            ordered[0].Kind,
            // Партии всех фракций группы в том же порядке: партия слева
            // соответствует фракции слева.
            [.. ordered.SelectMany(c => c.Parties)],
            ordered,
            key,
            ordered.Select(c => curated[c.Id].GroupDate).FirstOrDefault(d => d is not null),
            Localized($"FactionGroupParent_{key}"),
            Localized($"FactionGroupParentNote_{key}"));
    }

    private static string Day(DateOnly d) =>
        d.ToString("d MMMM yyyy", CultureInfo.CurrentUICulture);

    private string TermRange(KnessetTerm t) =>
        t.FinishDate is { } finish ? $"{Day(t.StartDate)} — {Day(finish)}" : Day(t.StartDate);

    private string? Localized(string key)
    {
        var value = L[key];
        return value.ResourceNotFound ? null : value.Value;
    }

    /// <summary>
    /// Форма слова «мандат» при числе. Правило славянское, но работает
    /// и для остальных языков: в английском, иврите и арабском все три
    /// ключа заполнены подходящими формами, и выбор между ними для этих
    /// языков сводится к «один или много».
    /// </summary>
    private string SeatWord(int n)
    {
        var t = n % 10;
        var h = n % 100;
        if (t == 1 && h != 11) return L["Factions_SeatOne"];
        if (t is >= 2 and <= 4 && h is < 12 or > 14) return L["Factions_SeatFew"];
        return L["Factions_SeatMany"];
    }
}
