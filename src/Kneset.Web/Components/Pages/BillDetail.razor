@page "/bills/{Id:int}"
@rendermode InteractiveServer
@using Kneset.Web.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation
@inject CurrentKnessetService CurrentKnesset

<PageTitle>@(_bill?.NameRu ?? _bill?.Name ?? L["Nav_Bills"])</PageTitle>

@* Визуальный слой. Два изменения:
   1. Окно влияния поднято под заголовок отдельной полосой — это главная идея
      продукта, а раньше оно было шестой строкой таблицы.
   2. Таблица метаданных на восемь строк стала grid-списком (.kt-meta-grid):
      те же поля занимают втрое меньше высоты, и реакция с обсуждением
      попадают на первый экран.
   Порядок блоков и все компоненты остались прежними. *@

@if (_bill is null)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/bills">@L["Nav_Bills"]</a></li>
            <li class="breadcrumb-item active">№@(_bill.Number?.ToString() ?? _bill.KnessetBillId.ToString())</li>
        </ol>
    </nav>

    <HeadContent>
        <meta property="og:title" content="@(_bill.NameRu ?? _bill.Name)" />
        <meta property="og:description" content="@OgDescription" />
        <meta property="og:url" content="@Navigation.Uri" />
        @* Динамическое превью: название + окно влияния + бар реакций. Абсолютный URL — краулеры не понимают относительные. *@
        <meta property="og:image" content="@($"{Navigation.BaseUri}og/bills/{_bill.Id}.png")" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
    </HeadContent>

    @* Оригинал всегда первой строкой. Название законопроекта в Израиле —
       формула с юридическим весом, и подменять её переводом нельзя. Перевод
       идёт под ним, помельче: он помогает понять, о чём закон, но ссылаться
       в переписке с комиссией нужно на оригинал. *@
    <h1 class="kt-bill-title" lang="he">@_bill.Name</h1>
    @if (Translated() is { } translated)
    {
        <div class="kt-bill-translated">@translated</div>
    }

    <div class="d-flex flex-wrap align-items-start gap-3">
        <ShareMenu Path="@($"/bills/{_bill.Id}")"
                   Title="@(_bill.NameRu ?? _bill.Name)"
                   Text="@string.Format(L["Share_BillText"], _bill.NameRu ?? _bill.Name)" />
        <div>
            <FollowButton Kind="SubscriptionKind.Bill" TargetId="@_bill.Id"
                          ReturnUrl="@($"/bills/{_bill.Id}")" />
        </div>
    </div>

    <div class="kt-window-band @(InfluenceWindowBadge.IsOpen(_bill.StatusDesc, _bill.KnessetNum, _currentKnesset) ? null : "kt-window-band-late")">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <InfluenceWindowBadge StatusDesc="@_bill.StatusDesc"
                                  KnessetNum="@_bill.KnessetNum"
                                  CurrentKnesset="@_currentKnesset" />
            <BillStatusBadge StatusDesc="@_bill.StatusDesc" />
        </div>
        <div class="kt-win-hint">@InfluenceHint</div>

        @* Адресат письменной позиции. Бейдж выше зовёт написать в комиссию —
           здесь и её название, и уже собранное письмо. Тело намеренно пустое:
           платформа, рассылающая сотни одинаковых писем, оборачивается стопкой
           копипасты в секретариате, а одно живое письмо весит больше. *@
        @if (_bill.Committee?.Email is { } email
             && InfluenceWindowBadge.IsOpen(_bill.StatusDesc, _bill.KnessetNum, _currentKnesset))
        {
            <div class="kt-write">
                <a class="btn btn-sm btn-outline-primary" href="@MailTo(email)">@L["Bill_WriteToCommittee"]</a>
                @* Адрес рядом с кнопкой, а не только внутри mailto. У человека
                   с почтой в браузере почтовый клиент не зарегистрирован, и
                   кнопка молча не делает ничего; видимый адрес можно выделить
                   и скопировать. dir=ltr обязателен: в ивритской и арабской
                   вёрстке адрес иначе рвётся на части. *@
                <span class="kt-write-mail" dir="ltr">@email</span>
            </div>
            <div class="kt-num kt-write-hint">@L["Bill_WriteHint"]</div>
        }
    </div>

    @* Шкала стадий. В макете она помечена как лоу-фай: «у закона нет истории
       стадий, только текущий StatusDesc и StatusChangedAt». История появилась
       вместе с BillSession — она собирается из повесток заседаний комиссий
       и пленума. Порядок хронологический: путь закона читается сверху вниз,
       назначенные заседания оказываются внизу, в будущем. *@
    @* Дорога целиком — до истории заседаний. Сначала «сколько осталось»,
       потом «что уже было»: без первого текущая стадия не говорит, середина
       это пути или почти конец. *@
    <section class="mt-4">
        <BillPipeline StatusId="@_bill.StatusId" SubTypeDesc="@_bill.SubTypeDesc"
                      VisitedStatusIds="@_visitedStatusIds" />
    </section>

    @if (_head.Count > 0)
    {
        <section class="kt-stages mt-4">
            <h3 class="kt-ctx-title">@L["Bill_Stages"]</h3>

            <ol class="kt-stage-list">
                @foreach (var s in _head)
                {
                    @StageRow(s)
                }

                @if (_hidden > 0)
                {
                    <li class="kt-stage-gap">
                        <span class="kt-stage-body">
                            @string.Format(L["Bill_StagesGap"],
                                $"{_hidden} {Plural.Of(_hidden, L["Bill_SittingForms"])}")
                        </span>
                    </li>
                }

                @foreach (var s in _tail)
                {
                    @StageRow(s)
                }
            </ol>
        </section>
    }

    <div class="row mt-4">
        <div class="col-lg-8">
            <div class="kt-meta-grid mb-4">
                <div class="kt-meta-item">
                    <span>@L["Knesset"]</span>
                    <span class="kt-num">@_bill.KnessetNum</span>
                </div>
                @if (_bill.SubTypeDesc is not null)
                {
                    <div class="kt-meta-item">
                        <span>@L["Type"]</span>
                        <span dir="rtl" lang="he">@_bill.SubTypeDesc</span>
                    </div>
                }
                @if (_bill.PublicationDate is not null)
                {
                    <div class="kt-meta-item">
                        <span>@L["PubDate"]</span>
                        <span class="kt-num">@_bill.PublicationDate.Value.ToString("dd.MM.yyyy")</span>
                    </div>
                }
                <div class="kt-meta-item">
                    <span>@L["UpdatedInKnesset"]</span>
                    <span class="kt-num">@_bill.LastUpdatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div class="kt-meta-item">
                    <span>@L["Initiators"]</span>
                    <span class="kt-num">@_bill.Initiators.Count</span>
                </div>
                @if (_bill.Committee is not null)
                {
                    <div class="kt-meta-item">
                        <span>@L["Bill_Committee"]</span>
                        <span>@CommitteeName(_bill.Committee)</span>
                    </div>
                }
                <div class="kt-meta-item">
                    <span>@L["Source"]</span>
                    <a href="https://main.knesset.gov.il/Activity/Legislation/Laws/Pages/LawBill.aspx?t=lawsuggestionssearch&lawitemid=@_bill.KnessetBillId"
                       target="_blank" rel="noopener">@L["OpenAtKnesset"]</a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_bill.SummaryLaw))
            {
                <h5>@L["Description"]</h5>
                <p dir="rtl" lang="he">@_bill.SummaryLaw</p>
            }

            @* Текст законопроекта и пояснительная записка живут файлами на сайте
               Кнессета. Ссылки, а не встроенный просмотр: fs.knesset.gov.il отдаёт
               PDF с X-Frame-Options SAMEORIGIN, и рамка на чужом домене всё равно
               осталась бы пустой. Проксировать файл через себя значит подменить
               первоисточник копией и взять на себя его свежесть. *@
            @if (_bill.Documents.Count > 0)
            {
                <h5>@L["Bill_Documents"]</h5>
                <ul class="kt-docs mb-4">
                    @foreach (var group in _bill.Documents
                        .GroupBy(d => new { d.KnessetDocumentId, d.GroupTypeDesc })
                        .OrderBy(g => g.Key.KnessetDocumentId))
                    {
                        <li>
                            <span dir="rtl" lang="he">@(group.Key.GroupTypeDesc ?? L["Bill_Document"].Value)</span>
                            @* Форматы одного документа — рядом, а не отдельными строками:
                               DOC и PDF это один и тот же текст. *@
                            @foreach (var doc in group.OrderBy(d => d.Format))
                            {
                                <a href="@doc.Url" target="_blank" rel="noopener" class="kt-doc-link">@doc.Format</a>
                            }

                            @* Текст — один на документ, а не на каждый формат: DOC и PDF
                               это одно и то же содержимое. Берём docx, если он есть:
                               из него текст извлекается логическим порядком, тогда как
                               в PDF он восстановлен по координатам глифов. *@
                            @{
                                var text = group
                                    .OrderBy(d => d.Format == "DOC" ? 0 : 1)
                                    .Select(d => _docTexts.GetValueOrDefault(d.Id))
                                    .FirstOrDefault(t => t is not null);
                            }
                            @if (text is not null)
                            {
                                <details class="kt-doc-text">
                                    <summary>@L["Bill_DocText"]</summary>
                                    <p class="kt-doc-text-note">@L["Bill_DocTextMachine"]</p>
                                    <div class="kt-doc-text-body" dir="rtl" lang="he">@text.Preview</div>
                                    @if (text.CharCount > text.Preview.Length)
                                    {
                                        <a href="/bills/@_bill.Id/text/@text.DocumentId" class="kt-doc-text-more">
                                            @L["Bill_DocTextFull"]
                                        </a>
                                    }
                                </details>
                            }
                        </li>
                    }
                </ul>
            }

            <AiAnalysisCard BillId="@_bill.Id" />

            <AnalysisHistoryCard BillId="@_bill.Id" />

            <ContextAnalysisCard BillId="@_bill.Id" />

            <CommentsSection BillId="@_bill.Id" />
        </div>

        <div class="col-lg-4">
            <ReactionWidget BillId="@_bill.Id" />

            <div class="card">
                <div class="card-header">@L["Initiators"] (@_bill.Initiators.Count)</div>
                <ul class="list-group list-group-flush">
                    @if (_bill.Initiators.Count == 0)
                    {
                        <li class="list-group-item text-muted">@L["NoInitiators"]</li>
                    }
                    @foreach (var initiator in _bill.Initiators
                        .OrderByDescending(i => i.IsInitiator).ThenBy(i => i.Ordinal))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="/members/@initiator.PersonId" dir="rtl" lang="he">@initiator.Person.FullName</a>
                            @if (initiator.IsInitiator)
                            {
                                <span class="kt-eyebrow" style="color: var(--kt-ember-600)">@L["InitiatorBadge"]</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@* Строка шкалы. Вынесена в шаблон, потому что рисуется дважды —
   до пропуска и после него. *@
@{
    RenderFragment StageRow(BillSession s) =>
    @<li class="@(s.StartDate > DateTime.UtcNow ? "kt-stage-future" : null)">
        <span class="kt-num kt-stage-date">@s.StartDate.ToLocalTime().ToString("dd.MM.yyyy")</span>
        <span class="kt-stage-body">
            <span class="kt-stage-kind">
                @(s.Kind == BillSessionKind.Plenum ? L["Ctx_Plenum"] : L["Ctx_Committee"])
            </span>
            @if (s.StatusDesc is not null)
            {
                <span class="kt-stage-status" dir="rtl" lang="he">@s.StatusDesc</span>
            }
        </span>
    </li>;
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>
    /// Название комиссии на языке интерфейса. Ключ — номер из справочника
    /// Кнессета; нет перевода (подкомиссия или новая) — показываем оригинал.
    /// </summary>
    private string CommitteeName(Committee c)
    {
        var s = L[$"Cmt_{c.Id}"];
        return s.ResourceNotFound ? c.Name : s.Value;
    }

    /// <summary>
    /// Готовое письмо в секретариат: адрес и тема с названием законопроекта
    /// на иврите — читать его будут там. Тело пустое, позицию человек пишет
    /// сам и отправляет из своей почтовой программы.
    /// </summary>
    private string MailTo(string email)
    {
        var subject = Uri.EscapeDataString($"{_bill!.Name} ({_bill.KnessetBillId})");
        return $"mailto:{email}?subject={subject}";
    }

    /// <summary>
    /// Перевод названия на язык интерфейса, если он есть. Иврит не переводим —
    /// на нём и лежит оригинал.
    /// </summary>
    private string? Translated()
    {
        var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        if (lang == "he") return null;

        var row = _bill?.Titles.FirstOrDefault(t => t.LanguageCode == lang);
        // Перевод устарел, если Кнессет переписал название: показываем только
        // тот, что сделан с нынешней формулировки.
        return row is not null && row.SourceName == _bill!.Name ? row.Text : null;
    }

    private Bill? _bill;

    /// <summary>Текущий созыв — по нему бейдж отличает живой закон от прекратившегося.</summary>
    private int? _currentKnesset;

    /// <summary>
    /// Сколько заседаний показываем. У долгоживущих законов их десятки,
    /// и полный список превращает карточку в протокол.
    /// </summary>
    private const int StageLimit = 12;

    /// <summary>Сколько первых заседаний оставляем при отсечке.</summary>
    private const int HeadCount = 3;

    /// <summary>Стадии всех заседаний закона — шкале нужны все, а не показанные.</summary>
    private List<int?> _visitedStatusIds = [];

    private List<BillSession> _head = [];
    private List<BillSession> _tail = [];
    private int _hidden;

    /// <summary>
    /// Сколько символов текста документа показываем на странице закона.
    /// Медиана извлечённого текста около пяти тысяч символов, но у документов
    /// комиссионных стадий бывает и двести тысяч — целиком такое в разметку
    /// отдавать нельзя, поэтому превью, а полный текст отдельной страницей.
    /// </summary>
    private const int PreviewChars = 4000;

    /// <summary>Превью текстов документов этого закона, по BillDocumentId.</summary>
    private Dictionary<int, DocText> _docTexts = [];

    private record DocText(int DocumentId, int CharCount, string Preview);

    /// <summary>Пояснение к окну влияния — тот же ключ ресурса, что и в бейдже.</summary>
    private string InfluenceHint
    {
        get
        {
            var window = InfluenceWindowBadge.Classify(_bill?.StatusDesc, _bill?.KnessetNum, _currentKnesset);
            return window is null ? "" : L[window.Value.HintKey];
        }
    }

    /// <summary>Описание для og:description — первые ~200 символов официального описания.</summary>
    private string OgDescription
    {
        get
        {
            var text = _bill?.SummaryLaw ?? _bill?.StatusDesc ?? "";
            return text.Length > 200 ? text[..200] + "…" : text;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _currentKnesset = await CurrentKnesset.GetAsync();

        _bill = await db.Bills.AsNoTracking()
            .Include(b => b.Initiators).ThenInclude(i => i.Person)
            .Include(b => b.Documents)
            .Include(b => b.Committee)
            .Include(b => b.Titles)
            .FirstOrDefaultAsync(b => b.Id == Id);

        if (_bill is not null)
        {
            // Тексты — отдельным запросом и только превью: Include тянул бы
            // полные тексты всех документов закона, а это мегабайты на запрос.
            // Обрезаем в SQL, а не в C#, чтобы лишнее не покидало базу.
            _docTexts = (await db.BillDocumentTexts.AsNoTracking()
                    .Where(t => t.BillDocument.BillId == _bill.Id && t.Status == "ok")
                    .Select(t => new DocText(
                        t.BillDocumentId, t.CharCount, t.Text.Substring(0, PreviewChars)))
                    .ToListAsync())
                .ToDictionary(t => t.DocumentId);

            // Отдельным запросом, а не Include: у закона бывает под два десятка
            // заседаний, и тянуть их join'ом вместе с сорока инициаторами значит
            // размножить строки в декартовом произведении.
            var rows = await db.BillSessions.AsNoTracking()
                .Where(x => x.BillId == _bill.Id)
                .OrderBy(x => x.StartDate)
                .ToListAsync();

            _visitedStatusIds = rows.Select(x => x.StatusId).ToList();

            // Отсечку делаем с середины, а не с конца. Обрезание «первых N»
            // выбрасывало назначенное заседание — единственную строку шкалы,
            // с которой можно что-то сделать сегодня. Показываем начало пути
            // и его последние шаги, а пропуск отмечаем явно.
            if (rows.Count > StageLimit)
            {
                _head = rows.Take(HeadCount).ToList();
                _tail = rows.Skip(rows.Count - (StageLimit - HeadCount)).ToList();
                _hidden = rows.Count - _head.Count - _tail.Count;
            }
            else
            {
                _head = rows;
                _tail = [];
                _hidden = 0;
            }
        }
    }
}
