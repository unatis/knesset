@page "/bills/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<PageTitle>@(_bill?.NameRu ?? _bill?.Name ?? L["Nav_Bills"])</PageTitle>

@if (_bill is null)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/bills">@L["Nav_Bills"]</a></li>
            <li class="breadcrumb-item active">№@(_bill.Number?.ToString() ?? _bill.KnessetBillId.ToString())</li>
        </ol>
    </nav>

    <HeadContent>
        <meta property="og:title" content="@(_bill.NameRu ?? _bill.Name)" />
        <meta property="og:description" content="@OgDescription" />
        <meta property="og:url" content="@Navigation.Uri" />
        @* Динамическое превью: название + окно влияния + бар реакций. Абсолютный URL — краулеры не понимают относительные. *@
        <meta property="og:image" content="@($"{Navigation.BaseUri}og/bills/{_bill.Id}.png")" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
    </HeadContent>

    <h2 dir="rtl" lang="he">@_bill.Name</h2>
    @if (_bill.NameRu is not null)
    {
        <h5 class="text-muted">@_bill.NameRu</h5>
    }

    <ShareMenu Path="@($"/bills/{_bill.Id}")"
               Title="@(_bill.NameRu ?? _bill.Name)"
               Text="@string.Format(L["Share_BillText"], _bill.NameRu ?? _bill.Name)" />

    <div class="row mt-4">
        <div class="col-lg-8">
            <table class="table">
                <tbody>
                    <tr>
                        <th style="width:220px">@L["Status"]</th>
                        <td><BillStatusBadge StatusDesc="@_bill.StatusDesc" /></td>
                    </tr>
                    <tr>
                        <th>@L["InfluenceWindow"]</th>
                        <td><InfluenceWindowBadge StatusDesc="@_bill.StatusDesc" ShowHint="true" /></td>
                    </tr>
                    <tr>
                        <th>@L["Knesset"]</th>
                        <td>@L["Knesset"] @_bill.KnessetNum</td>
                    </tr>
                    @if (_bill.SubTypeDesc is not null)
                    {
                        <tr>
                            <th>@L["Type"]</th>
                            <td dir="rtl" lang="he" style="text-align:left">@_bill.SubTypeDesc</td>
                        </tr>
                    }
                    @if (_bill.PublicationDate is not null)
                    {
                        <tr>
                            <th>@L["PubDate"]</th>
                            <td>@_bill.PublicationDate.Value.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                    <tr>
                        <th>@L["UpdatedInKnesset"]</th>
                        <td>@_bill.LastUpdatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th>@L["Source"]</th>
                        <td>
                            <a href="https://main.knesset.gov.il/Activity/Legislation/Laws/Pages/LawBill.aspx?t=lawsuggestionssearch&lawitemid=@_bill.KnessetBillId"
                               target="_blank" rel="noopener">@L["OpenAtKnesset"]</a>
                        </td>
                    </tr>
                </tbody>
            </table>

            @if (!string.IsNullOrWhiteSpace(_bill.SummaryLaw))
            {
                <h5>@L["Description"]</h5>
                <p dir="rtl" lang="he">@_bill.SummaryLaw</p>
            }

            <AiAnalysisCard BillId="@_bill.Id" />

            <AnalysisHistoryCard BillId="@_bill.Id" />

            <ContextAnalysisCard BillId="@_bill.Id" />

            <CommentsSection BillId="@_bill.Id" />
        </div>

        <div class="col-lg-4">
            <ReactionWidget BillId="@_bill.Id" />

            <div class="card">
                <div class="card-header">@L["Initiators"] (@_bill.Initiators.Count)</div>
                <ul class="list-group list-group-flush">
                    @if (_bill.Initiators.Count == 0)
                    {
                        <li class="list-group-item text-muted">@L["NoInitiators"]</li>
                    }
                    @foreach (var initiator in _bill.Initiators
                        .OrderByDescending(i => i.IsInitiator).ThenBy(i => i.Ordinal))
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <a href="/members/@initiator.PersonId" dir="rtl" lang="he">@initiator.Person.FullName</a>
                            @if (initiator.IsInitiator)
                            {
                                <span class="badge bg-primary">@L["InitiatorBadge"]</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Bill? _bill;

    /// <summary>Описание для og:description — первые ~200 символов официального описания.</summary>
    private string OgDescription
    {
        get
        {
            var text = _bill?.SummaryLaw ?? _bill?.StatusDesc ?? "";
            return text.Length > 200 ? text[..200] + "…" : text;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _bill = await db.Bills.AsNoTracking()
            .Include(b => b.Initiators).ThenInclude(i => i.Person)
            .FirstOrDefaultAsync(b => b.Id == Id);
    }
}
