@page "/initiatives/{Id:int}"
@rendermode InteractiveServer
@using Kneset.Web.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@inject InitiativeSigningService Signing

<PageTitle>@(_initiative?.Title ?? L["Nav_Initiatives"].Value)</PageTitle>

@if (_loading)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else if (_initiative is null)
{
    <div class="alert alert-warning">@L["Init_NotFound"]</div>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/initiatives">@L["Nav_Initiatives"]</a></li>
            <li class="breadcrumb-item active">№@_initiative.Id</li>
        </ol>
    </nav>

    @if (_initiative.Status == InitiativeStatus.Draft)
    {
        <div class="alert alert-secondary">@L["Init_DraftBanner"]</div>
    }

    <HeadContent>
        <meta property="og:title" content="@_initiative.Title" />
        <meta property="og:description" content="@(_initiative.ProblemDescription.Length > 200 ? _initiative.ProblemDescription[..200] + "…" : _initiative.ProblemDescription)" />
        <meta property="og:url" content="@Navigation.Uri" />
        @if (_initiative.Status != InitiativeStatus.Draft)
        {
            <meta property="og:image" content="@($"{Navigation.BaseUri}og/initiatives/{_initiative.Id}.png")" />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
        }
    </HeadContent>

    <h2>@_initiative.Title</h2>
    @if (_initiative.Status != InitiativeStatus.Draft)
    {
        <ShareMenu Path="@($"/initiatives/{_initiative.Id}")"
                   Title="@_initiative.Title"
                   Text="@string.Format(L["Share_InitText"], _initiative.Title)" />
    }
    <p class="text-muted">
        @L["Init_Author"]: @_authorName · @L["Init_Created"] @_initiative.CreatedAt.ToString("dd.MM.yyyy")
        @if (_initiative.PublishedAt is not null)
        {
            <span> · @L["Init_PublishedAt"] @_initiative.PublishedAt.Value.ToString("dd.MM.yyyy")</span>
        }
    </p>

    <div class="alert alert-light border" style="max-width:800px">@L["Init_DetailDisclaimer"]</div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <h5>@L["Init_Problem"]</h5>
            <p style="white-space:pre-line">@_initiative.ProblemDescription</p>

            <h5>@L["Init_Solution"]</h5>
            <p style="white-space:pre-line">@_initiative.ProposedSolution</p>

            <InitiativeDraftCard Initiative="_initiative" IsAuthor="_isAuthor"
                                 OnChanged="ReloadAsync" />

            @if (_initiative.Status != InitiativeStatus.Draft)
            {
                <CommentsSection InitiativeId="@_initiative.Id" />
            }
        </div>

        <div class="col-lg-4">
            @if (_initiative.Status != InitiativeStatus.Draft)
            {
                <InitiativeReactionWidget InitiativeId="@_initiative.Id" />
            }

            <div class="card">
                <div class="card-header">@L["Init_Support"]</div>
                <div class="card-body">
                    @{
                        var percent = Math.Min(100, _signatureCount * 100 / Math.Max(1, _initiative.SignatureThreshold));
                    }
                    <div class="d-flex justify-content-between mb-1">
                        <strong>@_signatureCount @L["Init_SigCount"]</strong>
                        <span class="text-muted">@L["Init_Threshold"] @_initiative.SignatureThreshold</span>
                    </div>
                    <div class="progress mb-3" style="height:10px">
                        <div class="progress-bar @(percent >= 100 ? "bg-success" : "")" style="width:@percent%"></div>
                    </div>

                    @if (_initiative.Status == InitiativeStatus.ThresholdReached)
                    {
                        <div class="alert alert-success py-2">@L["Init_ReachedMsg"]</div>
                    }

                    <AuthorizeView>
                        <Authorized>
                            @if (_initiative.Status == InitiativeStatus.Draft)
                            {
                                @if (_isAuthor)
                                {
                                    <button class="btn btn-primary w-100" @onclick="PublishAsync" disabled="@_busy">
                                        @L["Init_Publish"]
                                    </button>
                                }
                            }
                            else if (_hasSigned)
                            {
                                <button class="btn btn-outline-success w-100" disabled>@L["Init_Signed"]</button>
                            }
                            else
                            {
                                <button class="btn btn-success w-100" @onclick="SignAsync" disabled="@_busy">
                                    @L["Init_Sign"]
                                </button>
                            }
                        </Authorized>
                        <NotAuthorized>
                            @if (_initiative.Status != InitiativeStatus.Draft)
                            {
                                <a class="btn btn-outline-primary w-100"
                                   href="Account/Login?returnUrl=/initiatives/@_initiative.Id">
                                    @L["Init_LoginToSign"]
                                </a>
                            }
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private CitizenInitiative? _initiative;
    private string _authorName = "";
    private int _signatureCount;
    private bool _hasSigned;
    private bool _isAuthor;
    private bool _loading = true;
    private bool _busy;
    private string? _userId;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var auth = await AuthState;
            _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _initiative = await db.CitizenInitiatives.AsNoTracking()
            .Include(i => i.Author)
            .FirstOrDefaultAsync(i => i.Id == Id);

        if (_initiative is null) return;

        _isAuthor = _userId is not null && _initiative.AuthorId == _userId;

        // Черновик виден только автору.
        if (_initiative.Status == InitiativeStatus.Draft && !_isAuthor)
        {
            _initiative = null;
            return;
        }

        _authorName = _initiative.Author.DisplayName ?? _initiative.Author.UserName ?? "аноним";
        _signatureCount = await db.InitiativeSignatures.CountAsync(s => s.InitiativeId == Id);
        _hasSigned = _userId is not null &&
            await db.InitiativeSignatures.AnyAsync(s => s.InitiativeId == Id && s.UserId == _userId);
        StateHasChanged();
    }

    private async Task PublishAsync()
    {
        if (!_isAuthor || _initiative is null) return;
        _busy = true;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.CitizenInitiatives
            .Where(i => i.Id == Id && i.Status == InitiativeStatus.Draft)
            .ExecuteUpdateAsync(s => s
                .SetProperty(i => i.Status, InitiativeStatus.Published)
                .SetProperty(i => i.PublishedAt, DateTime.UtcNow));

        _busy = false;
        await ReloadAsync();
    }

    private async Task SignAsync()
    {
        if (_userId is null || _initiative is null) return;
        _busy = true;

        // Логика подписи живёт в сервисе: подписывать можно и отсюда,
        // и из карточки в ленте, а переход через порог меняет статус
        // инициативы — две копии такого расходиться не должны.
        await Signing.SignAsync(Id, _userId);

        _busy = false;
        await ReloadAsync();
    }
}
