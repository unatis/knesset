@page "/"
@rendermode InteractiveServer
@using Kneset.Core.Entities
@using Kneset.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L
@inject CurrentKnessetService CurrentKnesset
@inject SubscriptionRelevanceService Relevance
@inject InitiativeSigningService Signing

<PageTitle>@L["Brand"]</PageTitle>

@* Экран-знакомство только для гостя: вошедшему сразу нужна лента.

   Визуальный слой: emoji в герое и в ленте заменены на цветные точки и подписи
   капсом (см. .hero-points::before и .feed-kind-* в app.css). У карточек ленты
   появилась вторая строка с оригинальным названием на иврите — читатель сканирует
   список по названию на своём языке, а оригинал нужен для сверки с источником.

   Структура 2a: лента слева, столбец контекста справа. Табы «Моё / Всё» есть
   только у вошедшего — «Моё» строится из его подписок. *@
<div class="kt-home">
    <div class="kt-home-feed">

        <AuthorizeView>
            <NotAuthorized>
                <section class="hero">
                    <h1>@L["Home_HeroTitle"]</h1>
                    <p class="hero-text">@L["Home_HeroText"]</p>

                    <ul class="hero-points">
                        <li>@L["Home_Point1"]</li>
                        <li>@L["Home_Point2"]</li>
                        <li>@L["Home_Point3"]</li>
                    </ul>

                    <div class="hero-actions">
                        <a class="btn btn-primary" href="Account/Register">@L["Home_CtaJoin"]</a>
                        <a class="btn btn-outline-primary" href="bills">@L["Home_CtaBrowse"]</a>
                    </div>
                </section>
            </NotAuthorized>

            @* Вошедшему полноэкранное знакомство не нужно, но совсем без объяснения
               сайт оставлять нельзя — узкая полоска со ссылкой на страницу о проекте. *@
            <Authorized>
                <div class="home-strip">
                    <span>@L["Home_StripText"]</span>
                    <a href="about">@L["Home_StripMore"]</a>
                </div>
            </Authorized>
        </AuthorizeView>

        @if (_userId is null)
        {
            <h2 class="feed-title">@L["Home_FeedTitle"]</h2>
        }
        else
        {
            <div class="kt-tabs">
                <div class="kt-tabs-row" role="tablist">
                    <button type="button" role="tab" class="kt-tab @(_tab == Tab.Mine ? "kt-tab-on" : null)"
                            aria-selected="@(_tab == Tab.Mine)" @onclick="() => SwitchAsync(Tab.Mine)">
                        @L["Feed_TabMine"]
                    </button>
                    <button type="button" role="tab" class="kt-tab @(_tab == Tab.All ? "kt-tab-on" : null)"
                            aria-selected="@(_tab == Tab.All)" @onclick="() => SwitchAsync(Tab.All)">
                        @L["Feed_TabAll"]
                    </button>
                </div>

                @if (_summary is not null && !_summary.IsEmpty)
                {
                    <span class="kt-tabs-summary kt-num">
                        @L["Subs_Themes"]: @_summary.Themes ·
                        @L["Subs_Persons"]: @_summary.Persons ·
                        @L["Subs_Bills"]: @_summary.Bills
                    </span>
                }
            </div>
        }

        @if (_loading)
        {
            <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
        }
        else if (_tab == Tab.Mine && _summary is not null && _summary.IsEmpty)
        {
            @* Пустое «Моё» без объяснения читается как поломка. *@
            <div class="alert alert-light border">
                @L["Feed_MineNoSubs"]
                <a href="bills">@L["Home_CtaBrowse"]</a>
            </div>
        }
        else if (_feed.Count == 0)
        {
            <div class="alert alert-light border">@L["Home_FeedEmpty"]</div>
        }
        else
        {
            <div class="feed-list">
            @foreach (var item in _feed)
            {
                @* Черта «дальше вы уже видели». Ставится перед первым событием
                   старше прошлого визита — так человек понимает, где кончается
                   новое, и ему не приходится вспоминать, до какого места
                   он дочитал в прошлый раз. *@
                @if (ShowSeenDivider(item))
                {
                    <div class="kt-seen-divider">@L["Feed_SeenBefore"]</div>
                }

                <article class="feed-card">
                    <div class="feed-head">
                        <span class="feed-kind @item.KindCss">
                            @L[item.KindKey]
                            @if (item.Because is not null)
                            {
                                <span class="kt-because">· @item.Because</span>
                            }
                        </span>
                        <span class="feed-time">@RelativeTime(item.At)</span>
                    </div>

                    <a class="feed-link" href="@item.Url" lang="@(item.IsHebrew ? "he" : null)">@item.Title</a>

                    @if (item.Original is not null)
                    {
                        <div class="feed-orig" lang="he">@item.Original</div>
                    }

                    @if (item.BillId is int billId)
                    {
                        <div class="feed-meta">
                            <InfluenceWindowBadge StatusDesc="@item.StatusDesc"
                                                  KnessetNum="@item.KnessetNum"
                                                  CurrentKnesset="@_currentKnesset" />
                        </div>

                        var counts = _reactions.GetValueOrDefault(billId);
                        @if (counts is not null && counts.Total > 0)
                        {
                            <ReactionBar Support="counts.Support" Oppose="counts.Oppose"
                                         Undecided="counts.Undecided" Compact="true" />
                        }
                    }
                    else if (item.Signatures is not null)
                    {
                        <div class="feed-meta kt-num">
                            @item.Signatures @Plural.Of(item.Signatures ?? 0, L["Init_SigForms"]) · @L["Init_Threshold"] @item.Threshold
                        </div>

                        @* Подписать можно прямо отсюда. Инициатива живёт подписями,
                           и требовать ради одной подписи открытия отдельной страницы
                           значит терять тех, кто просто листал ленту. *@
                        @if (item.InitiativeId is int initiativeId)
                        {
                            <div class="feed-meta">
                                @if (_userId is null)
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="Account/Login?returnUrl=/initiatives/@initiativeId">
                                        @L["Init_LoginToSign"]
                                    </a>
                                }
                                else if (_signed.Contains(initiativeId))
                                {
                                    <span class="kt-eyebrow">@L["Init_Signed"]</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary"
                                            disabled="@_signing"
                                            @onclick="() => SignAsync(initiativeId)">
                                        @L["Init_Sign"]
                                    </button>
                                }
                            </div>
                        }
                    }
                    else if (item.Subtitle is not null)
                    {
                        <div class="feed-quote">@item.Subtitle</div>
                    }
                </article>
            }
            </div>

            @* Дописывает события в ту же ленту, а не уводит на другую страницу
               с другой вёрсткой. Курсор по времени, а не Skip: лента склеена
               из четырёх выборок с дедупликацией, и смещение по ней давало бы
               и пропуски, и повторы. *@
            @if (_hasMore)
            {
                <button class="btn btn-outline-secondary w-100 mt-3"
                        disabled="@_loadingMore" @onclick="LoadMoreAsync">
                    @(_loadingMore ? L["Feed_Loading"] : L["Feed_ShowMore"])
                </button>
            }

            <a class="btn btn-link w-100 mt-2" href="bills">@L["Feed_AllBills"]</a>
        }
    </div>

    <ContextColumn RelevantBillIds="_relevantIds" RefreshToken="_ctxRefresh" />
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private enum Tab { Mine, All }

    private sealed record FeedItem(
        DateTime At,
        string KindCss,
        string KindKey,
        string Title,
        string Url,
        bool IsHebrew,
        /// <summary>Заполнен, если карточка показывает сам закон: бейдж окна и бар реакций.</summary>
        int? BillId = null,
        string? StatusDesc = null,
        string? Subtitle = null,
        int? Signatures = null,
        int? Threshold = null,
        string? Original = null,
        string? Because = null,
        /// <summary>
        /// К какому закону относится событие — независимо от вида карточки.
        /// У обсуждения BillId пустой (карточка показывает цитату, а не бейдж),
        /// но закон у события есть, и по нему считаются повод подписки и склейка
        /// событий одного закона.
        /// </summary>
        int? SourceBillId = null,
        /// <summary>
        /// Инициатива, к которой относится карточка. По ней рисуется кнопка
        /// подписи прямо в ленте: ради подписи не должно требоваться
        /// открывать отдельную страницу.
        /// </summary>
        int? InitiativeId = null,
        /// <summary>
        /// Созыв закона. Вместе с текущим созывом решает, не прекратился ли
        /// законопроект: с роспуском Кнессета незавершённые процедуры кончаются,
        /// а текст статуса при этом остаётся прежним и обещает лишнее.
        ///
        /// Параметр в самом конце намеренно: вызовы FeedItem позиционные,
        /// и вставка в середину сдвинула бы все последующие аргументы.
        /// </summary>
        int? KnessetNum = null);

    /// <summary>Текущий созыв — по нему бейдж отличает живой закон от прекратившегося.</summary>
    private int? _currentKnesset;

    private sealed record Counts(int Support, int Oppose, int Undecided)
    {
        public int Total => Support + Oppose + Undecided;
    }

    private const int FeedSize = 30;

    /// <summary>
    /// Сколько мест в ленте отведено гражданским инициативам. Небольшая доля:
    /// лента остаётся про Кнессет, но созданное людьми из неё не исчезает.
    /// </summary>
    private const int InitiativeSlots = 4;

    private List<FeedItem> _feed = [];
    private Dictionary<int, Counts> _reactions = [];
    private bool _loading = true;

    private string? _userId;
    private Tab _tab = Tab.Mine;
    private SubscriptionSummary? _summary;

    /// <summary>Инициативы, которые этот пользователь уже подписал.</summary>
    private HashSet<int> _signed = [];
    private bool _signing;

    /// <summary>Растёт после действий, после которых столбцу контекста
    /// нужно перечитать свои блоки.</summary>
    private int _ctxRefresh;

    /// <summary>Что уже показано: подгрузка не должна повторять карточки.</summary>
    private readonly HashSet<int> _shownBills = [];
    private readonly HashSet<int> _shownInitiatives = [];

    /// <summary>Время самого старого показанного события — курсор подгрузки.</summary>
    private DateTime? _oldest;
    private bool _hasMore = true;
    private bool _loadingMore;

    /// <summary>
    /// Отметка прошлого визита, прочитанная до её обновления. По ней
    /// проводится черта в ленте.
    /// </summary>
    private DateTime? _lastSeen;

    /// <summary>Черта рисуется один раз за отрисовку списка.</summary>
    private bool _dividerShown;
    private bool _anyNew;

    /// <summary>Насколько часто обновляем отметку визита.</summary>
    private static readonly TimeSpan SeenThrottle = TimeSpan.FromMinutes(10);
    private Dictionary<int, SubscriptionReason> _relevance = [];
    private List<int>? _relevantIds;

    protected override async Task OnInitializedAsync()
    {
        _currentKnesset = await CurrentKnesset.GetAsync();

        if (AuthState is not null)
        {
            var auth = await AuthState;
            _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        if (_userId is not null)
        {
            await ReadFeedSeenAsync();
            _summary = await Relevance.GetSummaryAsync(_userId);
            _relevance = await Relevance.GetRelevantBillsAsync(_userId);
            _relevantIds = _relevance.Keys.ToList();

            // Без подписок «Моё» пустое, и открывать его первым бессмысленно.
            if (_summary.IsEmpty) _tab = Tab.All;
        }
        else
        {
            _tab = Tab.All;
        }

        await LoadFeedAsync();
        _loading = false;
    }

    private async Task SwitchAsync(Tab tab)
    {
        if (_tab == tab) return;

        _tab = tab;
        _loading = true;
        await LoadFeedAsync();
        _loading = false;
    }

    /// <summary>
    /// Первая страница ленты. Сбрасывает накопленное и запоминает, что уже
    /// показано: подгрузка не должна повторять карточки.
    /// </summary>
    private async Task LoadFeedAsync()
    {
        _shownBills.Clear();
        _shownInitiatives.Clear();
        _feed = [];
        _oldest = null;
        _hasMore = true;

        var page = await FetchPageAsync(before: null);
        _feed = page;
        _dividerShown = false;
        _anyNew = false;
        await LoadCardExtrasAsync();
    }

    /// <summary>
    /// Следующая порция — события старше самого старого из показанных.
    /// Именно курсор по времени, а не Skip: лента склеивается из четырёх
    /// выборок с дедупликацией, и смещение по ней давало бы и пропуски,
    /// и повторы.
    /// </summary>
    private async Task LoadMoreAsync()
    {
        if (_loadingMore || !_hasMore || _oldest is null) return;

        _loadingMore = true;
        var page = await FetchPageAsync(before: _oldest);
        _feed = _feed.Concat(page).ToList();
        await LoadCardExtrasAsync();
        _loadingMore = false;
    }

    private async Task<List<FeedItem>> FetchPageAsync(DateTime? before)
    {
        // «Моё» — те же четыре выборки, но суженные до законов из подписок.
        // Отдельного набора запросов нет намеренно: две ленты, расходящиеся
        // в логике, начали бы показывать разное про одно и то же событие.
        var mine = _tab == Tab.Mine && _relevantIds is { Count: > 0 };
        var ids = mine ? _relevantIds! : null;

        if (_tab == Tab.Mine && !mine)
        {
            _hasMore = false;
            return [];
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var items = new List<FeedItem>();

        // 1. Новые законопроекты.
        var newBills = db.Bills.AsNoTracking().Where(b => b.FirstSeenAt > DateTime.UnixEpoch);
        if (ids is not null) newBills = newBills.Where(b => ids.Contains(b.Id));
        if (before is { } b1) newBills = newBills.Where(b => b.FirstSeenAt < b1);

        items.AddRange(await newBills
            .OrderByDescending(b => b.FirstSeenAt)
            .Take(FeedSize)
            .Select(b => new FeedItem(
                b.FirstSeenAt, "feed-kind-bill", "Feed_NewBill",
                b.NameRu ?? b.Name, $"/bills/{b.Id}", b.NameRu == null,
                b.Id, b.StatusDesc, null, null, null,
                b.NameRu == null ? null : b.Name,
                null, b.Id, null, b.KnessetNum))
            .ToListAsync());

        // 2. Смена стадии — главное событие для «окна влияния».
        var changed = db.Bills.AsNoTracking().Where(b => b.StatusChangedAt != null);
        if (ids is not null) changed = changed.Where(b => ids.Contains(b.Id));
        if (before is { } b2) changed = changed.Where(b => b.StatusChangedAt < b2);

        items.AddRange(await changed
            .OrderByDescending(b => b.StatusChangedAt)
            .Take(FeedSize)
            .Select(b => new FeedItem(
                b.StatusChangedAt!.Value, "feed-kind-status", "Feed_StatusChanged",
                b.NameRu ?? b.Name, $"/bills/{b.Id}", b.NameRu == null,
                b.Id, b.StatusDesc, null, null, null,
                b.NameRu == null ? null : b.Name,
                null, b.Id, null, b.KnessetNum))
            .ToListAsync());

        // 3. Гражданские инициативы — единственные события, созданные людьми.
        //    Показываем их и в «Моём»: к подпискам они не привязаны, но это
        //    не повод прятать. Подписки отвечают на вопрос «за чем я слежу»,
        //    а инициативу нужно увидеть всем, иначе подписей ей не собрать.
        var initiatives = db.CitizenInitiatives.AsNoTracking()
            .Where(i => i.Status != InitiativeStatus.Draft && i.PublishedAt != null);
        if (before is { } b3) initiatives = initiatives.Where(i => i.PublishedAt < b3);

        items.AddRange(await initiatives
            .OrderByDescending(i => i.PublishedAt)
            .Take(InitiativeSlots)
            .Select(i => new FeedItem(
                i.PublishedAt!.Value, "feed-kind-initiative", "Feed_NewInitiative",
                i.Title, $"/initiatives/{i.Id}", false,
                null, null, null,
                i.Signatures.Count, i.SignatureThreshold, null, null, null,
                i.Id))
            .ToListAsync());

        // 4. Обсуждение: показываем, где сейчас спорят.
        var comments = db.Comments.AsNoTracking();
        if (ids is not null) comments = comments.Where(c => c.BillId != null && ids.Contains(c.BillId.Value));
        if (before is { } b4) comments = comments.Where(c => c.CreatedAt < b4);

        items.AddRange(await comments
            .OrderByDescending(c => c.CreatedAt)
            .Take(FeedSize)
            .Select(c => new FeedItem(
                c.CreatedAt, "feed-kind-comment", "Feed_NewComment",
                c.Bill != null ? (c.Bill.NameRu ?? c.Bill.Name) : c.Initiative!.Title,
                c.BillId != null ? $"/bills/{c.BillId}#comment-{c.Id}"
                                 : $"/initiatives/{c.InitiativeId}#comment-{c.Id}",
                c.Bill != null && c.Bill.NameRu == null,
                // BillId намеренно пустой: карточка обсуждения показывает цитату,
                // а не бейдж окна с баром реакций. Закон события — в SourceBillId.
                null, null,
                c.Text.Length > 120 ? c.Text.Substring(0, 120) + "…" : c.Text,
                null, null, null, null, c.BillId))
            .ToListAsync());

        // Один закон — одна карточка. У закона бывает и появление, и смена стадии,
        // и обсуждение: формально это разные события, но карточка показывает
        // текущее состояние закона, поэтому более старое событие не добавляет
        // ничего и читается как дубль. Во «Всём» такие пары почти не встречались
        // рядом — выборки берутся из тысяч записей; в «Моём», где пул сужен
        // до подписок, они сталкиваются сразу. Оставляем самое свежее событие.
        var merged = items
            .OrderByDescending(i => i.At)
            // Уже показанное не повторяем: подгрузка идёт по времени, а один
            // и тот же закон мог попасть на предыдущую страницу другим событием.
            .Where(i => i.SourceBillId is not { } sb || !_shownBills.Contains(sb))
            .Where(i => i.InitiativeId is not { } si || !_shownInitiatives.Contains(si))
            .GroupBy(i => i.SourceBillId)
            // Ключ null — это инициативы: у них нет закона, и склеивать их
            // друг с другом нельзя, это разные сущности.
            .SelectMany(g => g.Key is null ? g : g.Take(1))
            .OrderByDescending(i => i.At)
            .ToList();

        // Места под инициативы бронируются, а не разыгрываются по времени.
        // Кнессет приезжает пачками: один прогон синхронизации даёт три десятка
        // смен стадии с одинаковой отметкой времени и вытесняет из ленты всё
        // остальное. Проверено на живой базе — все тридцать карточек оказывались
        // одного вида. Инициатив на три порядка меньше, и по свежести они
        // проигрывают всегда, поэтому им отводится фиксированная доля.
        var reserved = merged.Where(i => i.InitiativeId is not null).Take(InitiativeSlots).ToList();
        var rest = merged.Where(i => i.InitiativeId is null).Take(FeedSize - reserved.Count);

        var page = reserved.Concat(rest)
            .OrderByDescending(i => i.At)
            .ToList();

        // Кнопка «Показать ещё» исчезает, когда порция пришла неполной:
        // значит источники исчерпаны.
        _hasMore = page.Count >= FeedSize;
        if (page.Count > 0) _oldest = page[^1].At;

        foreach (var item in page)
        {
            if (item.SourceBillId is { } sb) _shownBills.Add(sb);
            if (item.InitiativeId is { } si) _shownInitiatives.Add(si);
        }

        // Повод подписки дописывается только в «Моём»: во «Всём» он был бы ложью —
        // события там показываются независимо от того, подписан человек или нет.
        return mine
            ? page.Select(i => i with { Because = BecauseOf(i.SourceBillId) }).ToList()
            : page;
    }

    /// <summary>
    /// Подписи и счётчики реакций для всех накопленных карточек. Считается
    /// заново после каждой подгрузки: два словаря на всю ленту дешевле,
    /// чем разбирать, что добавилось.
    /// </summary>
    private async Task LoadCardExtrasAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Что из попавших в ленту инициатив человек уже подписал.
        if (_userId is not null)
        {
            var initiativeIds = _feed
                .Where(i => i.InitiativeId is not null)
                .Select(i => i.InitiativeId!.Value)
                .ToList();
            _signed = await Signing.GetSignedAsync(initiativeIds, _userId);
        }

        // Счётчики реакций одним запросом только по попавшим в ленту законам.
        var billIds = _feed.Where(i => i.BillId != null).Select(i => i.BillId!.Value).Distinct().ToList();
        _reactions = [];
        if (billIds.Count > 0)
        {
            _reactions = (await db.BillReactions.AsNoTracking()
                    .Where(r => billIds.Contains(r.BillId))
                    .GroupBy(r => new { r.BillId, r.Kind })
                    .Select(g => new { g.Key.BillId, g.Key.Kind, Count = g.Count() })
                    .ToListAsync())
                .GroupBy(x => x.BillId)
                .ToDictionary(g => g.Key, g => new Counts(
                    g.FirstOrDefault(x => x.Kind == ReactionKind.Support)?.Count ?? 0,
                    g.FirstOrDefault(x => x.Kind == ReactionKind.Oppose)?.Count ?? 0,
                    g.FirstOrDefault(x => x.Kind == ReactionKind.Undecided)?.Count ?? 0));
        }
    }

    /// <summary>Отметка прошлого визита — только чтение, до отрисовки.</summary>
    private async Task ReadFeedSeenAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _lastSeen = await db.Users
            .Where(u => u.Id == _userId)
            .Select(u => u.LastFeedSeenAt)
            .FirstOrDefaultAsync();
    }

    /// <summary>
    /// Продвигает отметку визита. Вызывается только после первой отрисовки
    /// интерактивной цепи, а не при инициализации: страница выполняется дважды —
    /// сначала предрендером, потом в цепи, — и запись в первом проходе
    /// отравляла чтение во втором. Из-за этого на самом первом заходе лента
    /// целиком оказывалась «уже виденной».
    ///
    /// Порог нужен, чтобы открытие главной не превращалось в запись в базу
    /// на каждый просмотр страницы.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _userId is null) return;

        var now = DateTime.UtcNow;
        if (_lastSeen is { } seen && now - seen <= SeenThrottle) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Users.Where(u => u.Id == _userId)
            .ExecuteUpdateAsync(x => x.SetProperty(u => u.LastFeedSeenAt, now));
    }

    private async Task SignAsync(int initiativeId)
    {
        if (_userId is null || _signing) return;

        _signing = true;
        await Signing.SignAsync(initiativeId, _userId);
        _signed.Add(initiativeId);
        _signing = false;
        _ctxRefresh++;

        // Перечитываем ленту: у подписанной инициативы изменился счётчик,
        // а при переходе порога — ещё и статус.
        await LoadFeedAsync();
    }

    /// <summary>
    /// Нужна ли черта перед этой карточкой. Возвращает true ровно один раз —
    /// на первом событии, которое человек уже видел.
    /// </summary>
    private bool ShowSeenDivider(FeedItem item)
    {
        if (_lastSeen is not { } seen || _dividerShown) return false;

        if (item.At > seen)
        {
            _anyNew = true;
            return false;
        }

        // Нового нет вовсе — черта в самом верху ничего не сообщает:
        // «ниже вы всё видели», а выше пусто. Тогда её не показываем.
        if (!_anyNew) return false;

        _dividerShown = true;
        return true;
    }

    /// <summary>«Почему это здесь» — тема, депутат или сам закон.</summary>
    private string? BecauseOf(int? billId)
    {
        if (billId is null || !_relevance.TryGetValue(billId.Value, out var reason)) return null;

        return reason.Kind switch
        {
            SubscriptionKind.Keyword => string.Format(L["Feed_BecauseTheme"], reason.Detail),
            SubscriptionKind.Person => string.Format(L["Feed_BecausePerson"], reason.Detail),
            SubscriptionKind.Bill => L["Feed_BecauseBill"],
            _ => null
        };
    }

    private string RelativeTime(DateTime utc)
    {
        var delta = DateTime.UtcNow - utc;

        if (delta.TotalMinutes < 1) return L["Time_JustNow"];
        if (delta.TotalHours < 1) return string.Format(L["Time_Minutes"], (int)delta.TotalMinutes);
        if (delta.TotalDays < 1) return string.Format(L["Time_Hours"], (int)delta.TotalHours);
        if (delta.TotalDays < 30) return string.Format(L["Time_Days"], (int)delta.TotalDays);

        return utc.ToLocalTime().ToString("dd.MM.yyyy");
    }
}
