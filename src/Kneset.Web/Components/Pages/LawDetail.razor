@page "/laws/{Id:int}"
@rendermode InteractiveServer
@using Kneset.Core.Entities
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_law?.Name ?? L["Laws_Title"].Value)</PageTitle>

@if (_loading)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else if (_law is null)
{
    <div class="alert alert-warning">@L["Laws_NotFound"]</div>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/laws">@L["Laws_Title"]</a></li>
        </ol>
    </nav>

    <h2 dir="rtl" lang="he">@_law.Name</h2>

    <div class="mb-3">
        @if (_law.IsBasicLaw)
        {
            <span class="badge bg-dark me-1">@L["Laws_BasicLaw"]</span>
        }
        @if (_law.IsBudgetLaw)
        {
            <span class="badge bg-secondary me-1">@L["Laws_BudgetLaw"]</span>
        }
    </div>

    <table class="table" style="max-width:640px">
        <tbody>
            @if (_law.ValidityDesc is not null)
            {
                <tr>
                    <th style="width:220px">@L["Laws_Validity"]</th>
                    <td dir="rtl" lang="he" style="text-align:start">@_law.ValidityDesc</td>
                </tr>
            }
            @if (_law.ValidityStartDate is not null)
            {
                <tr>
                    <th>@L["Laws_InForceSince"]</th>
                    <td>@_law.ValidityStartDate.Value.ToString("dd.MM.yyyy")</td>
                </tr>
            }
            @if (_law.PublicationDate is not null)
            {
                <tr>
                    <th>@L["Laws_Published"]</th>
                    <td>@_law.PublicationDate.Value.ToString("dd.MM.yyyy")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_amendments.Count == 0)
    {
        <h5 class="mt-4">@L["Laws_Amendments"]</h5>
        <p class="text-muted">@L["Laws_NoAmendments"]</p>
    }
    else
    {
        @* Ведём счётом: он точен для всех поправок, тогда как названия
           источник публикует лишь для малой части. *@
        <div class="row g-2 mt-4 mb-3">
            <div class="col-4">
                <div class="border rounded p-2 text-center">
                    <div class="small text-muted">@L["Laws_AmendTotal"]</div>
                    <div class="fs-4">@_amendments.Count</div>
                </div>
            </div>
            <div class="col-4">
                <div class="border border-warning bg-warning-subtle rounded p-2 text-center">
                    <div class="small text-muted">@L["Laws_AmendIndirect"]</div>
                    <div class="fs-4">@_indirect.Count</div>
                </div>
            </div>
            <div class="col-4">
                <div class="border rounded p-2 text-center">
                    <div class="small text-muted">@L["Laws_AmendDirect"]</div>
                    <div class="fs-4">@_directCount</div>
                </div>
            </div>
        </div>

        @if (_indirect.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>⚠ @L["Laws_Indirect"]</strong>
                <p class="mb-0 mt-1 small">@L["Laws_IndirectExplain"]</p>
            </div>
        }

        @if (_named.Count > 0)
        {
            <h5>@L["Laws_NamedOnly"] (@_named.Count)</h5>
            <ul class="list-group">
                @foreach (var amendment in _named)
                {
                    <li class="list-group-item @(amendment.IsIndirect ? "list-group-item-warning" : "")">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <span dir="rtl" lang="he">@amendment.ActName</span>
                            <span class="flex-shrink-0">
                                @if (amendment.IsOriginal)
                                {
                                    <span class="badge bg-secondary">@L["Laws_Original"]</span>
                                }
                                else if (amendment.IsIndirect)
                                {
                                    <span class="badge bg-warning text-dark">@L["Laws_Indirect"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@L["Laws_Direct"]</span>
                                }
                            </span>
                        </div>
                        @if (amendment.ActPublicationDate is not null)
                        {
                            <small class="text-muted">@amendment.ActPublicationDate.Value.ToString("dd.MM.yyyy")</small>
                        }
                    </li>
                }
            </ul>
        }

        @if (_unnamedCount > 0)
        {
            @* Честно про пробел в источнике, а не молча пустой список. *@
            <p class="text-muted small mt-3">@string.Format(L["Laws_UnnamedNote"], _unnamedCount)</p>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private IsraelLaw? _law;
    private List<LawAmendment> _amendments = [];
    private List<LawAmendment> _indirect = [];
    private List<LawAmendment> _named = [];
    private int _directCount;
    private int _unnamedCount;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _law = await db.IsraelLaws.AsNoTracking().FirstOrDefaultAsync(l => l.Id == Id);

        if (_law is not null)
        {
            _amendments = await db.LawAmendments.AsNoTracking()
                .Where(a => a.IsraelLawId == Id)
                // Косвенные наверх: ради них раздел и делался.
                .OrderByDescending(a => a.IsIndirect)
                .ThenByDescending(a => a.ActPublicationDate)
                .ToListAsync();

            _indirect = _amendments.Where(a => a.IsIndirect).ToList();
            _directCount = _amendments.Count(a => !a.IsIndirect && !a.IsOriginal);

            // Названия актов Кнессет публикует только для новых: старые акты
            // лежат в другом диапазоне идентификаторов, которого нет в наборе.
            _named = _amendments.Where(a => !string.IsNullOrWhiteSpace(a.ActName)).ToList();
            _unnamedCount = _amendments.Count - _named.Count;
        }

        _loading = false;
    }
}
