@page "/laws/{Id:int}"
@using Kneset.Core.Entities
@using System.Globalization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_translated ?? _law?.Name ?? L["Laws_Title"].Value)</PageTitle>

@if (_loading)
{
    <div class="text-center p-5"><div class="spinner-border" role="status"></div></div>
}
else if (_law is null)
{
    <div class="alert alert-warning">@L["Laws_NotFound"]</div>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/laws">@L["Laws_Title"]</a></li>
        </ol>
    </nav>

    @* Оригинал первой строкой: название закона — формула, на которую
       ссылаются другие законы и суды. Перевод под ним, помельче.

       Оформление то же, что у законопроекта (kt-bill-title): у заголовка
       unicode-bidi: plaintext и выравнивание по интерфейсу. Прежний
       dir="rtl" уводил иврит к правому краю, и за название страницы
       принимался перевод. *@
    <h1 class="kt-bill-title" lang="he">@_law.Name</h1>
    @if (_translated is { } translated)
    {
        <div class="kt-bill-translated">@translated</div>
    }

    <div class="mb-3">
        @if (_law.IsBasicLaw)
        {
            <span class="badge bg-dark me-1">@L["Laws_BasicLaw"]</span>
        }
        @if (_law.IsBudgetLaw)
        {
            <span class="badge bg-secondary me-1">@L["Laws_BudgetLaw"]</span>
        }
    </div>

    @if (_topics.Count > 0)
    {
        @* Рубрикатор Кнессета, а не наша классификация: у темы есть источник. *@
        <div class="kt-law-topics mb-3">
            @foreach (var t in _topics)
            {
                <a class="kt-law-topic" href="/laws?topic=@t.Id">@t.Name</a>
            }
            <small class="text-muted d-block mt-1">@L["Laws_TopicSource"]</small>
        </div>
    }

    @* Текст закона. Единственное место, где он у нас есть, — ссылка:
       в открытых данных Кнессета сводного текста нет вовсе, а собирать его
       самим из оригинала и всех поправок значит делать правовую
       консолидацию, то есть другой продукт. Ведём туда, куда ведёт
       сам Кнессет. *@
    <div class="kt-law-links mb-3">
        @if (_law.OpenBookUrl is { Length: > 0 } book)
        {
            <a class="btn btn-outline-primary btn-sm" href="@book"
               target="_blank" rel="noopener">@L["Laws_FullText"]</a>
        }
        @if (_law.KolZchutUrl is { Length: > 0 } zchut)
        {
            <a class="btn btn-outline-secondary btn-sm" href="@zchut"
               target="_blank" rel="noopener">@L["Laws_PlainLanguage"]</a>
        }
        <a class="btn btn-outline-secondary btn-sm"
           href="https://main.knesset.gov.il/apps/legislation/main/laws/@_law.KnessetIsraelLawId"
           target="_blank" rel="noopener">@L["Laws_AtKnesset"]</a>
    </div>
    @if (_law.OpenBookUrl is { Length: > 0 })
    {
        <p class="text-muted small" style="max-width:60ch">@L["Laws_FullTextSource"]</p>
    }

    <table class="table" style="max-width:640px">
        <tbody>
            @if (_law.ValidityDesc is not null)
            {
                <tr>
                    <th style="width:220px">@L["Laws_Validity"]</th>
                    <td dir="rtl" lang="he" style="text-align:start">@_law.ValidityDesc</td>
                </tr>
            }
            @if (_law.ValidityStartDate is not null)
            {
                <tr>
                    <th>@L["Laws_InForceSince"]</th>
                    <td>@_law.ValidityStartDate.Value.ToString("dd.MM.yyyy")</td>
                </tr>
            }
            @if (_law.Ministries is { Length: > 0 })
            {
                <tr>
                    <th>@L["Laws_Ministries"]</th>
                    <td dir="rtl" lang="he" style="text-align:start">@_law.Ministries</td>
                </tr>
            }
            @if (_law.PublicationDate is not null)
            {
                <tr>
                    <th>@L["Laws_Published"]</th>
                    <td>@_law.PublicationDate.Value.ToString("dd.MM.yyyy")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_amendments.Count == 0)
    {
        <h5 class="mt-4">@L["Laws_Amendments"]</h5>
        <p class="text-muted">@L["Laws_NoAmendments"]</p>
    }
    else
    {
        @* Ведём счётом: он точен для всех поправок, тогда как названия
           источник публикует лишь для малой части. *@
        <div class="row g-2 mt-4 mb-3">
            <div class="col-4">
                <div class="border rounded p-2 text-center">
                    <div class="small text-muted">@L["Laws_AmendTotal"]</div>
                    <div class="fs-4">@_amendments.Count</div>
                </div>
            </div>
            <div class="col-4">
                <div class="border border-warning bg-warning-subtle rounded p-2 text-center">
                    <div class="small text-muted">@L["Laws_AmendIndirect"]</div>
                    <div class="fs-4">@_indirect.Count</div>
                </div>
            </div>
            <div class="col-4">
                <div class="border rounded p-2 text-center">
                    <div class="small text-muted">@L["Laws_AmendDirect"]</div>
                    <div class="fs-4">@_directCount</div>
                </div>
            </div>
        </div>

        @if (_indirect.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>⚠ @L["Laws_Indirect"]</strong>
                <p class="mb-0 mt-1 small">@L["Laws_IndirectExplain"]</p>
            </div>
        }

        @* Текст закона. Копия сводной редакции, а не наша сводка: поэтому
           рядом стоит источник, номер ревизии и оговорка, что юридическую
           силу имеет публикация в «Рэумот», а не эта страница. Разворот
           через details — страница остаётся статической, а текст бывает
           на сорок тысяч знаков. *@
        @if (_text is not null)
        {
            <h5 class="mt-4">@L["Laws_TextHeading"]</h5>
            <p class="text-muted small" style="max-width:60ch">
                @string.Format(L["Laws_TextSource"], _text.RevisionAt.ToString("dd.MM.yyyy"))
            </p>
            <details class="kt-law-text">
                <summary>@L["Laws_TextExpand"] · @_text.CharCount</summary>
                <div class="kt-law-text-body" dir="rtl" lang="he">@_text.Text</div>
            </details>
        }

        @if (_named.Count > 0)
        {
            <h5>@L["Laws_NamedOnly"] (@_named.Count)</h5>
            <ul class="list-group">
                @foreach (var amendment in _named)
                {
                    <li class="list-group-item @(amendment.IsIndirect ? "list-group-item-warning" : "")">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <span dir="rtl" lang="he">@amendment.ActName</span>
                            <span class="flex-shrink-0">
                                @if (amendment.IsOriginal)
                                {
                                    <span class="badge bg-secondary">@L["Laws_Original"]</span>
                                }
                                else if (amendment.IsIndirect)
                                {
                                    <span class="badge bg-warning text-dark">@L["Laws_Indirect"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@L["Laws_Direct"]</span>
                                }
                            </span>
                        </div>
                        @* Дата, официальная ссылка на публикацию и текст самой
                           поправки. Ни того, ни другого нет в открытых данных —
                           это со страницы закона на сайте Кнессета. Своего
                           номера у израильского закона нет, ссылаются именно
                           на публикацию: серия, сборник, страница. *@
                        @* Пустой контейнер не рисуем: у старых актов бывает,
                           что нет ни даты, ни публикации. *@
                        @if (amendment.ActPublicationDate is not null
                             || amendment.PublicationSeries is { Length: > 0 }
                             || amendment.DocumentUrl is { Length: > 0 })
                        {
                        <div class="kt-law-cite">
                            @if (amendment.ActPublicationDate is not null)
                            {
                                <small class="text-muted">@amendment.ActPublicationDate.Value.ToString("dd.MM.yyyy")</small>
                            }
                            @if (amendment.PublicationSeries is { Length: > 0 } series)
                            {
                                <small class="text-muted" dir="rtl" lang="he">
                                    @series@(amendment.MagazineNumber is { Length: > 0 } num ? $" {num}" : "")@(
                                        amendment.PageNumber is { Length: > 0 } page
                                            ? ", " + string.Format(L["Laws_PublicationPage"], page)
                                            : "")
                                </small>
                            }
                            @if (amendment.DocumentUrl is { Length: > 0 } doc)
                            {
                                <a class="kt-law-cite-pdf" href="@doc" target="_blank" rel="noopener">@L["Laws_ActPdf"]</a>
                            }
                        </div>
                        }
                    </li>
                }
            </ul>
        }

        @if (_unnamedCount > 0)
        {
            @* Честно про пробел в источнике, а не молча пустой список. *@
            <p class="text-muted small mt-3">@string.Format(L["Laws_UnnamedNote"], _unnamedCount)</p>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private IsraelLaw? _law;
    private List<LawAmendment> _amendments = [];
    private List<LawAmendment> _indirect = [];
    private List<LawAmendment> _named = [];
    private int _directCount;
    private int _unnamedCount;
    private string? _translated;
    private List<TopicLink> _topics = [];
    private IsraelLawText? _text;

    private sealed record TopicLink(int Id, string Name);
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _law = await db.IsraelLaws.AsNoTracking().FirstOrDefaultAsync(l => l.Id == Id);

        if (_law is not null)
        {
            // Иврит — оригинал в Name, переводить его некуда и незачем.
            var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            if (lang != "he")
            {
                _translated = await db.IsraelLawTitles.AsNoTracking()
                    .Where(t => t.IsraelLawId == Id && t.LanguageCode == lang)
                    .Select(t => t.Text)
                    .FirstOrDefaultAsync();
            }

            _text = await db.IsraelLawTexts.AsNoTracking()
                .FirstOrDefaultAsync(t => t.IsraelLawId == Id);

            var topics = await db.LawTopics.AsNoTracking()
                .Where(t => t.IsraelLawId == Id)
                .Select(t => new { t.TopicId, t.NameHe })
                .ToListAsync();

            _topics = topics
                .Select(t => new TopicLink(t.TopicId, TopicNaming.Localized(L, t.TopicId, t.NameHe)))
                .OrderBy(t => t.Name, StringComparer.CurrentCulture)
                .ToList();

            _amendments = await db.LawAmendments.AsNoTracking()
                .Where(a => a.IsraelLawId == Id)
                // Косвенные наверх: ради них раздел и делался.
                .OrderByDescending(a => a.IsIndirect)
                .ThenByDescending(a => a.ActPublicationDate)
                .ToListAsync();

            _indirect = _amendments.Where(a => a.IsIndirect).ToList();
            _directCount = _amendments.Count(a => !a.IsIndirect && !a.IsOriginal);

            // Названия актов Кнессет публикует только для новых: старые акты
            // лежат в другом диапазоне идентификаторов, которого нет в наборе.
            _named = _amendments.Where(a => !string.IsNullOrWhiteSpace(a.ActName)).ToList();
            _unnamedCount = _amendments.Count - _named.Count;
        }

        _loading = false;
    }

}
